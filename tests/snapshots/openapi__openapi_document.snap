    "/v1/lol/matches/{region}/{matchId}": {
      "get": {
        "description": "match-v5, passed through. Matches are immutable and served from the archive once seen (`X-Cache: ARCHIVE`). The match id's platform must belong to `region`.",
        "operationId": "match_by_id",
        "parameters": [
          {
            "description": "Regional routing value",
            "in": "path",
            "name": "region",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Platform-prefixed id, e.g. EUW1_7381937461",
            "in": "path",
            "name": "matchId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {}
            },
            "description": "Riot's payload, unmodified. `X-Cache` and `X-Cache-Age` describe where it came from."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "A parameter failed validation (`VALIDATION`, or `BAD_REGION` for a platform or region)."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing or invalid key."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The key lacks a scope."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
