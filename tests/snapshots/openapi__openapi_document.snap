    "/v1/players/{puuid}/matches": {
      "get": {
        "description": "The id page, then every match on it, fanned out concurrently. Archived matches come from one archive read at no quota cost. Each entry is the player's own line in the game; the full match stays one call away at `/v1/lol/matches/{region}/{matchId}`. A match that cannot be fetched is left out and named in `warnings`; a failed id lookup fails the page.\n\n**`champion`** filters by champion. Riot's id list cannot, so the page comes from this deployment's archive: Riot's newest 20 ids are read and archived first, then the archive is paged for that champion's games, newest first. Older games appear as the player's backfill archives them; `archive.complete` says whether it has reached the start of their history. `type` cannot be combined with `champion`.",
        "operationId": "match_page",
        "parameters": [
          {
            "description": "Encrypted player UUID",
            "in": "path",
            "name": "puuid",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Platform routing value, e.g. `oc1`. Required",
            "in": "query",
            "name": "platform",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "0–10000, default 0",
            "in": "query",
            "name": "start",
            "required": false,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "description": "1–20, default 10: every id is its own upstream call",
            "in": "query",
            "name": "count",
            "required": false,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "description": "Queue id, 0–5000",
            "in": "query",
            "name": "queue",
            "required": false,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "description": "ranked, normal, tourney or tutorial; not with `champion`",
            "in": "query",
            "name": "type",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Champion id, 1–10000: only that champion's archived games",
            "in": "query",
            "name": "champion",
            "required": false,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "description": "Re-read the id list; once a minute per player",
            "in": "query",
            "name": "refresh",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MatchPage"
                }
              }
            },
            "description": "The page",
            "headers": {
              "X-Cache": {
                "$ref": "#/components/headers/X-Cache"
              },
              "X-Cache-Age": {
                "$ref": "#/components/headers/X-Cache-Age"
              },
              "X-Cache-Fetched-Age": {
                "$ref": "#/components/headers/X-Cache-Fetched-Age"
              },
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/X-RateLimit-Limit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/X-RateLimit-Remaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/X-RateLimit-Reset"
              },
              "X-Request-Id": {
                "$ref": "#/components/headers/X-Request-Id"
              }
            }
