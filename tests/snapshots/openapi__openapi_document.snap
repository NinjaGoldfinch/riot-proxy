    "/v1/riot/accounts/by-riot-id/{region}/{gameName}/{tagLine}": {
      "get": {
        "description": "account-v1 by Riot ID. The body is Riot's, unmodified. `sea` is accepted and routed to `asia`, since account-v1 has no `sea` host.",
        "operationId": "account_by_riot_id",
        "parameters": [
          {
            "description": "Regional routing value: americas, europe, asia or sea",
            "in": "path",
            "name": "region",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The part of a Riot ID before the `#` (1–16 characters)",
            "in": "path",
            "name": "gameName",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The part of a Riot ID after the `#` (1–5 characters)",
            "in": "path",
            "name": "tagLine",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {}
            },
            "description": "Riot's payload, unmodified. `X-Cache` and `X-Cache-Age` describe where it came from."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "A parameter failed validation (`VALIDATION`, or `BAD_REGION` for a platform or region)."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing or invalid key."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The key lacks a scope."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not found upstream; a cached 404 carries `X-Cache: HIT-NEG`."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Your consumer quota is spent (`QUOTA_EXCEEDED`)."
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Riot failed or rejected the proxy's key (`UPSTREAM_ERROR`)."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Riot's rate limit budget is exhausted (`RATE_LIMITED`, with `Retry-After`)."
          }
        },
        "summary": "Account by Riot ID",
        "tags": [
          "riot"
        ]
      }
    },
    "/v1/static/queues": {
      "get": {
        "description": "Maps `queueId` to a map and a description — what `420` means where the archive and the composite routes report one. Refreshed on every `ddragon:sync`, not only on a new patch: Riot adds queue ids when a game mode ships, which is not a patch event.",
        "operationId": "static_queues",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Riot's `queues.json`"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "A parameter failed validation (`VALIDATION`, or `BAD_REGION` for a platform or region)."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing or invalid key."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The key lacks a scope, or the admin IP allowlist refused the caller."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not found."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Your consumer quota is spent (`QUOTA_EXCEEDED`)."
          }
        },
        "summary": "Riot's queue id table",
        "tags": [
          "static"
        ]
      }
    },
    "/v1/static/versions": {
      "get": {
        "description": "`{current, versions}`: the mirrored patch (null before the first `ddragon:sync`) and Riot's patch list, newest first. `X-Cache: HIT` from the mirror; before the first sync the list is fetched live from Data Dragon (`MISS`).",
        "operationId": "static_versions",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "`{current, versions}`"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "A parameter failed validation (`VALIDATION`, or `BAD_REGION` for a platform or region)."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing or invalid key."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The key lacks a scope, or the admin IP allowlist refused the caller."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not found."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Your consumer quota is spent (`QUOTA_EXCEEDED`)."
          }
        },
        "summary": "Data Dragon patches",
        "tags": [
          "static"
        ]
      }
    },
    "/v1/static/{file}": {
      "get": {
        "description": "Data Dragon's JSON for the mirrored patch, or for `?version=` when that patch was mirrored. Plural aliases name the same files (`champions` is `champion`).",
        "operationId": "static_file",
        "parameters": [
          {
            "description": "Data Dragon name or alias",
            "in": "path",
            "name": "file",
            "required": true,
            "schema": {
              "description": "`/v1/static/{file}`'s names, for the document (v1's enum, in its order).",
              "enum": [
                "champion",
                "item",
                "runesReforged",
                "summoner",
                "profileicon",
                "map",
                "champions",
                "items",
                "runes",
                "summoner-spells",
                "profile-icons",
                "maps"
              ],
              "type": "string"
            }
          },
          {
            "description": "A mirrored patch; default the current one",
            "example": "16.17.1",
            "in": "query",
            "name": "version",
            "required": false,
            "schema": {
              "maxLength": 20,
              "pattern": "^[0-9]+(\\.[0-9]+)*$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Data Dragon's JSON, untouched"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "A parameter failed validation (`VALIDATION`, or `BAD_REGION` for a platform or region)."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing or invalid key."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The key lacks a scope, or the admin IP allowlist refused the caller."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not found."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Your consumer quota is spent (`QUOTA_EXCEEDED`)."
          }
        },
        "summary": "A mirrored Data Dragon file",
        "tags": [
          "static"
        ]
      }
    },
    "/v1/ws": {
      "get": {
        "description": "Upgrade with `Authorization: Bearer rpx_…`, or `?token=rpx_…` from a browser. The server sends `{\"op\":\"ready\",\"consumer\":…}`, then:\n\n- `{\"op\":\"subscribe\",\"topics\":[…]}` / `{\"op\":\"unsubscribe\",\"topics\":[…]}` → `{\"op\":\"subscribed\",\"topics\":[…]}`, listing everything the socket holds. A topic that was refused is absent.\n- `{\"op\":\"ping\"}` → `{\"op\":\"pong\",\"at\":…}`.\n- Events arrive as `{\"op\":\"event\",\"event\":…,\"topic\":…,\"at\":…,\"data\":{…}}`.\n- `{\"op\":\"resync\",\"topic\":…,\"dropped\":n}` means this socket fell behind and missed `n` events on that topic; re-read what it covers.\n- Problems arrive as `{\"op\":\"error\",\"error\":{\"code\",\"message\"}}` without closing the socket.\n\n**Topics:** `player:<puuid>` (game, rank and archive events for one player), `patch`, and admin only: `metrics` (a snapshot every `METRICS_INTERVAL_S` while subscribed), `ladder`, `firehose` (every event). At most 200 per socket. The server pings every 30 s and drops a socket after two unanswered pings.\n\n**Events:** `game.started`, `game.ended`, `rank.changed`, `match.archived` (player topics); `patch.new`; `crawl.phase`, `ladder.crawl.completed`, `analytics.updated` (`ladder`); `metrics.snapshot` (`metrics`).\n\n**Closes:** 4401 for an invalid or revoked key, 1001 on server shutdown.",
        "operationId": "socket",
        "parameters": [
          {
            "description": "The consumer key, for browsers that cannot set headers",
            "in": "query",
            "name": "token",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "101": {
            "description": "Switching protocols"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Your consumer quota is spent"
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "tokenQuery": []
          }
        ],
        "summary": "Realtime events over a WebSocket",
        "tags": [
          "ws"
        ]
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "servers": [
    {
      "description": "Local development",
      "url": "http://localhost:8080"
    },
    {
      "description": "Your deployment",
      "url": "{scheme}://{host}",
      "variables": {
        "host": {
          "default": "riot-proxy.example.com"
        },
        "scheme": {
          "default": "https",
          "enum": [
            "https",
            "http"
          ]
        }
      }
    }
  ],
  "tags": [
    {
      "description": "Composite player reads",
      "name": "players"
    },
    {
      "description": "Riot account-v1, passed through",
      "name": "riot"
    },
    {
      "description": "League of Legends endpoints",
