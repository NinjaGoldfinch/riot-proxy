          {
            "description": "Encrypted player UUID",
            "in": "path",
            "name": "puuid",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "0–10000, default 0",
            "in": "query",
            "name": "start",
            "required": false,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "description": "1–100, default 20",
            "in": "query",
            "name": "count",
            "required": false,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
