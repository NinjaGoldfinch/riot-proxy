    "/v1/players/by-riot-id/{gameName}/{tagLine}/profile": {
      "get": {
        "description": "The same document, entered by Riot ID. The account lookup is reused as the `account` part rather than fetched twice.",
        "operationId": "profile_by_riot_id",
        "parameters": [
          {
            "description": "The part of a Riot ID before the `#` (1–16 characters)",
            "in": "path",
            "name": "gameName",
