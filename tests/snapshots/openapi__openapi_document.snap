              "type": "string"
            }
          },
          {
            "description": "Platform routing value; default `DEFAULT_PLATFORM`",
            "in": "query",
            "name": "platform",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "1–20, default 5",
            "in": "query",
