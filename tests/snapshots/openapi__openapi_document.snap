          },
          "phase": {
            "description": "Which stage a running crawl is in. `enumerate` walks the ladder, `collect` gathers every\ndiscovered player's match ids, and `archive` fetches the matches behind them — in that\norder, so a match shared by ten players is fetched once.",
            "type": "string"
          },
