            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "queueId",
          "matches"
        ],
        "type": "object"
      },
      "QueueCounts": {
        "description": "One v1 queue's jobs by state (v1 `QueueCounts`).",
        "properties": {
          "active": {
            "format": "int64",
            "type": "integer"
          },
          "completed": {
            "description": "Done in the last hour.",
            "format": "int64",
            "type": "integer"
          },
          "delayed": {
            "description": "Pending, waiting out a backoff.",
            "format": "int64",
            "type": "integer"
          },
          "failed": {
            "description": "Failed in the last 24 hours.",
            "format": "int64",
            "type": "integer"
          },
          "prioritized": {
            "description": "Always 0: every v2 job has a priority, so `waiting` holds them all.",
            "format": "int64",
            "type": "integer"
          },
          "scheduled": {
            "description": "Always 0: v2's ticks are timers, not parked jobs.",
            "format": "int64",
            "type": "integer"
          },
          "waiting": {
            "description": "Pending and due.",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "active",
          "waiting",
          "prioritized",
          "delayed",
          "scheduled",
          "failed",
          "completed"
        ],
        "type": "object"
      },
      "QueueDdragonSync": {
        "description": "`POST /v1/admin/ddragon/sync` body (v1).",
        "properties": {
          "force": {
            "description": "Re-download a patch that is already mirrored. Default false.",
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "Ready": {
        "description": "v1 returned `{ok, redis, postgres, keyScope}`. v2 has one store, so `sqlite` replaces\nthe two backend booleans, and `limiter` says the checkpoint was restored\n(design/07). `keyScope` is v1's (ADR-011). `sqliteReaders`/`sqliteReadersFree`\nshow the read pool, so a leak shows before reads fail (ADR-113).",
        "properties": {
          "keyScope": {
            "type": "string"
          },
          "limiter": {
            "type": "boolean"
          },
          "ok": {
            "type": "boolean"
          },
          "sqlite": {
            "type": "boolean"
          },
          "sqliteReaders": {
            "description": "SQLite read connections in the pool.",
            "minimum": 0,
            "type": "integer"
          },
          "sqliteReadersFree": {
            "description": "Of those, how many are idle now. Informational: 0 under load is normal and\ndoesn't make the probe fail.",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "ok",
          "sqlite",
          "limiter",
          "keyScope",
          "sqliteReaders",
          "sqliteReadersFree"
        ],
        "type": "object"
      },
      "RecomputeAnalytics": {
        "description": "`POST /v1/admin/analytics/recompute` body (v1).",
