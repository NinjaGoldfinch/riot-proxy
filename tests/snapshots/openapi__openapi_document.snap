    "/v1/players/{puuid}/champions": {
      "get": {
        "description": "Per champion: games, wins, win rate, average KDA, CS per minute and when it was last played, grouped at read time from the archive, most played first. Never contacts Riot, so it costs no quota; it only reports the games this deployment has archived for the player.",
        "operationId": "champions",
        "parameters": [
          {
            "description": "Encrypted player UUID",
            "in": "path",
            "name": "puuid",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Only games on this platform (by match id prefix)",
            "in": "query",
            "name": "platform",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Queue id, 0–5000",
            "in": "query",
            "name": "queue",
            "required": false,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "description": "`major.minor`, e.g. 14.18",
            "in": "query",
            "name": "patch",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "1–500, default 200",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "description": "`exclude` (default) or `include` games Riot flagged as remakes",
            "in": "query",
            "name": "remakes",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlayerChampions"
                }
              }
            },
            "description": "The pool"
