    "/v1/lol/analytics/champions/{championId}/matchups": {
      "get": {
        "description": "Sends an `ETag`; a matching `If-None-Match` gets 304. Every lane matchup this champion has archived data for. No tier dimension: sample sizes die fast enough per (champion, opponent, role) alone, and the two laners can sit in different tiers anyway. Mirror lanes are excluded — their win rate is 50% by construction. A matchup is recorded from the tracked ladder player's side, so the opposite champion's view of the same lane only exists when that player is tracked too, and the two directions can disagree.",
        "operationId": "champion_matchups",
        "parameters": [
          {
            "description": "Champion id, ≥ 1",
            "in": "path",
            "name": "championId",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "description": "Only this platform's ladder. Omitted sums every platform",
            "in": "query",
            "name": "platform",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "RANKED_SOLO_5x5 or RANKED_FLEX_SR",
            "in": "query",
            "name": "queue",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "`major.minor`; default the newest aggregated patch",
            "in": "query",
            "name": "patch",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "TOP, JUNGLE, MIDDLE, BOTTOM or UTILITY; default every lane",
            "in": "query",
            "name": "role",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "≥ 0; no default",
            "in": "query",
            "name": "minGames",
            "required": false,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "description": "1–200, default 50",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "description": "`exclude` (default) or `include`",
            "in": "query",
            "name": "remakes",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChampionMatchupsResponse"
                }
              }
            },
            "description": "The matchups, most played first"
          },
          "304": {
            "description": "Not modified"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "A parameter failed validation (`VALIDATION`, or `BAD_REGION` for a platform or region)."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing or invalid key."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The key lacks a scope, or the admin IP allowlist refused the caller."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not found."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Your consumer quota is spent (`QUOTA_EXCEEDED`)."
          }
        },
        "summary": "A champion's lane matchups",
        "tags": [
          "lol"
        ]
      }
    },
