      "description": "Realtime events",
      "name": "ws"
    },
    {
      "description": "Health and metrics; no key needed",
      "name": "ops"
    },
    {
      "description": "Administration; admin scope and IP allowlist",
      "name": "admin"
    }
  ],
  "x-tagGroups": [
