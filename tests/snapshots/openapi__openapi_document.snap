    "/v1/lol/league/apex/{platform}/{tier}/{queue}": {
      "get": {
        "description": "MASTER, GRANDMASTER or CHALLENGER for one queue. One request returns every entry; not paged.",
        "operationId": "league_apex",
        "parameters": [
          {
            "description": "Platform routing value",
            "in": "path",
            "name": "platform",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "MASTER, GRANDMASTER or CHALLENGER",
            "in": "path",
            "name": "tier",
            "required": true,
            "schema": {
              "type": "string"
            }
