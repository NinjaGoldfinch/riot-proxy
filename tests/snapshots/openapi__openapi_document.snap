    "/v1/players/{puuid}/champions": {
      "get": {
        "description": "Per champion: games, wins, win rate, average KDA, CS per minute and when it was last played, grouped at read time from the archive, most played first. Never contacts Riot, so it costs no quota; it only reports the games this deployment has archived for the player.",
        "operationId": "champions",
        "parameters": [
          {
            "description": "Encrypted player UUID",
