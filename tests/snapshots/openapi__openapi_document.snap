---
source: tests/openapi.rs
expression: doc
---
{
  "components": {
    "headers": {
      "Cache-Control": {
        "description": "`public, max-age=31536000, immutable`: the bytes at this path never change.",
        "schema": {
          "type": "string"
        }
      },
      "Last-Modified": {
        "description": "When the copy on disk was written, for `If-Modified-Since`. Not sent by the response that first fetched it.",
        "schema": {
          "type": "string"
        }
      },
      "Retry-After": {
        "description": "Seconds to wait before trying again.",
        "schema": {
          "type": "integer"
        }
      },
      "X-Cache": {
        "description": "Where the body came from: `HIT`, `MISS`, `STALE`, `HIT-NEG` (a cached 404), `ARCHIVE` (the match archive) or `BYPASS` (`?refresh=true`).",
        "schema": {
          "type": "string"
        }
      },
      "X-Cache-Age": {
        "description": "Seconds the content has been unchanged, not since the last fetch.",
        "schema": {
          "type": "integer"
        }
      },
      "X-Cache-Fetched-Age": {
        "description": "Seconds since the proxy last read it from Riot, changed or not. Not sent for `ARCHIVE`.",
        "schema": {
          "type": "integer"
        }
      },
      "X-RateLimit-Limit": {
        "description": "Your consumer quota per minute.",
        "schema": {
          "type": "integer"
        }
      },
      "X-RateLimit-Remaining": {
        "description": "Requests left in the current minute.",
        "schema": {
          "type": "integer"
        }
      },
      "X-RateLimit-Reset": {
        "description": "Seconds until a request slot frees up.",
        "schema": {
          "type": "integer"
        }
      },
      "X-Request-Id": {
        "description": "This request's id; quote it when reporting a problem.",
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "AccountDto": {
        "description": "account-v1 `AccountDto`.",
        "properties": {
          "gameName": {
            "description": "This field may be excluded from the response if the account doesn't have a gameName.",
            "type": "string"
          },
          "puuid": {
            "description": "Encrypted PUUID. Exact length of 78 characters.",
            "type": "string"
          },
          "tagLine": {
            "description": "This field may be excluded from the response if the account doesn't have a tagLine.",
            "type": "string"
          }
        },
        "required": [
          "puuid"
        ],
        "type": "object"
      },
      "AdminStats": {
        "description": "Archive and tracking counts (v1's three fields, plus archive size).",
        "properties": {
          "archiveRawBytes": {
            "description": "What they decompress to.",
            "format": "int64",
            "type": "integer"
          },
          "archiveStoredBytes": {
            "description": "Compressed bytes the archive's match bodies take.",
            "format": "int64",
            "type": "integer"
          },
          "archivedMatches": {
            "description": "The whole archive, which is not key-scoped and survives a key rotation.",
            "format": "int64",
            "type": "integer"
          },
          "archivedTimelines": {
            "format": "int64",
            "type": "integer"
          },
          "keyScope": {
            "type": "string"
          },
          "knownPlayers": {
            "description": "Player rows for the current key, tracked or not.",
            "format": "int64",
            "type": "integer"
          },
          "trackedPlayers": {
            "description": "Scoped to the current key: zero right after a rotation.",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "keyScope",
          "archivedMatches",
          "trackedPlayers",
          "knownPlayers",
          "archivedTimelines",
          "archiveStoredBytes",
          "archiveRawBytes"
        ],
        "type": "object"
      },
      "AnalyticsPatchEntry": {
        "description": "One aggregated patch (ADR-094).",
        "properties": {
          "computedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "games": {
            "description": "Participant games, as `totalGames` counts them on the champions route;\nwith `championId`, that champion's games.",
            "format": "int64",
            "type": "integer"
          },
          "patch": {
            "description": "`major.minor`.",
            "type": "string"
          }
        },
        "required": [
          "patch",
          "games",
          "computedAt"
        ],
        "type": "object"
      },
      "AnalyticsPatchesResponse": {
        "description": "The patches a ladder has analytics for (ADR-094).",
        "properties": {
          "championId": {
            "description": "The champion asked for, whose games each entry then counts; `null` for every champion.",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "patches": {
            "description": "Newest first.",
            "items": {
              "$ref": "#/components/schemas/AnalyticsPatchEntry"
            },
            "type": "array"
          },
          "platform": {
            "description": "`null` when the request named no platform: every platform summed.",
            "type": [
              "string",
              "null"
            ]
          },
          "queue": {
            "type": "string"
          }
        },
        "required": [
          "platform",
          "queue",
          "championId",
          "patches"
        ],
        "type": "object"
      },
      "AnalyticsSection": {
        "properties": {
          "lastRuns": {
            "items": {
              "$ref": "#/components/schemas/RunSummary"
            },
            "type": "array"
          },
          "topChampions": {
            "description": "The newest run's ladder, its latest patch, top five by games.",
            "items": {
              "$ref": "#/components/schemas/TopChampion"
            },
            "type": "array"
          }
        },
        "required": [
          "lastRuns",
          "topChampions"
        ],
        "type": "object"
      },
      "ArchiveCoverage": {
        "description": "How much of a player's history a champion-filtered page draws on (SITE-02).",
        "properties": {
          "complete": {
            "description": "A backfill has walked the player's whole history (it stamped `doneAt`).\nUntil then the page holds only the games archived so far: their newest\ngames, and whatever earlier pages, tracking or a walk in progress stored.",
            "type": "boolean"
          }
        },
        "required": [
          "complete"
        ],
        "type": "object"
      },
      "ArchiveTotals": {
        "description": "What the archive holds for one player: exact counts from `match_facts`.",
        "properties": {
          "byQueue": {
            "description": "Most matches first.",
            "items": {
              "$ref": "#/components/schemas/QueueCount"
            },
            "type": "array"
          },
          "matches": {
            "format": "int64",
            "type": "integer"
          },
          "newestGameEnd": {
            "type": [
              "string",
              "null"
            ]
          },
          "oldestGameEnd": {
            "type": [
              "string",
              "null"
            ]
          },
          "remakes": {
            "description": "Matches Riot flagged as remakes; counted in `matches`.",
            "format": "int64",
            "type": "integer"
          },
          "timelines": {
            "description": "Of `matches`, how many also have a stored timeline.",
            "format": "int64",
            "type": "integer"
          },
          "wins": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "matches",
          "remakes",
          "wins",
          "timelines",
          "oldestGameEnd",
          "newestGameEnd",
          "byQueue"
        ],
        "type": "object"
      },
      "ArchivedLine": {
        "description": "The player's line in one archived match.",
        "properties": {
          "assists": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "championId": {
            "format": "int64",
            "type": "integer"
          },
          "cs": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "deaths": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "gameDuration": {
            "description": "Seconds.",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "gameEndTimestamp": {
            "format": "int64",
            "type": "integer"
          },
          "kills": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "matchId": {
            "type": "string"
          },
          "position": {
            "type": [
              "string",
              "null"
            ]
          },
          "queueId": {
            "format": "int64",
            "type": "integer"
          },
          "remake": {
            "description": "Null until the match's facts have been re-extracted (V0005).",
            "type": [
              "boolean",
              "null"
            ]
          },
          "win": {
            "type": "boolean"
          }
        },
        "required": [
          "matchId",
          "queueId",
          "gameEndTimestamp",
          "gameDuration",
          "remake",
          "championId",
          "position",
          "win",
          "kills",
          "deaths",
          "assists",
          "cs"
        ],
        "type": "object"
      },
      "ArchivedPage": {
        "description": "`GET /v1/admin/players/{puuid}/archive/matches`.",
        "properties": {
          "count": {
            "format": "int64",
            "type": "integer"
          },
          "matches": {
            "items": {
              "$ref": "#/components/schemas/ArchivedLine"
            },
            "type": "array"
          },
          "puuid": {
            "type": "string"
          },
          "start": {
            "format": "int64",
            "type": "integer"
          },
          "total": {
            "description": "Every archived match for this player and filter, not just this page.",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "puuid",
          "total",
          "start",
          "count",
          "matches"
        ],
        "type": "object"
      },
      "BackfillNotice": {
        "description": "Present when this lookup queued the player's history for archiving.",
        "properties": {
          "jobId": {
            "type": "string"
          },
          "limit": {
            "description": "How far back the walk will go, in matches. `4294967295` (the default,\n`LOOKUP_BACKFILL_LIMIT`) means the whole history: the walk stops where\nRiot's id list ends (ADR-081).",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "status": {
            "description": "`queued`, or `already-queued` when another request got there first.",
            "type": "string"
          }
        },
        "required": [
          "jobId",
          "status",
          "limit"
        ],
        "type": "object"
      },
      "BuildItemOption": {
        "description": "One choice at one step of a set build: an item (BLD-03).",
        "properties": {
          "games": {
            "format": "int64",
            "type": "integer"
          },
          "itemId": {
            "format": "int64",
            "type": "integer"
          },
          "winRate": {
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "itemId",
          "games",
          "winRate"
        ],
        "type": "object"
      },
      "BuildRuneOption": {
        "description": "A keystone and secondary tree.",
        "properties": {
          "games": {
            "format": "int64",
            "type": "integer"
          },
          "keystoneId": {
            "format": "int64",
            "type": "integer"
          },
          "subStyleId": {
            "format": "int64",
            "type": "integer"
          },
          "winRate": {
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "keystoneId",
          "subStyleId",
          "games",
          "winRate"
        ],
        "type": "object"
      },
      "BuildSkillOrderOption": {
        "description": "A skill order: Q, W and E in the order they were maxed, `\"QWE\"`.",
        "properties": {
          "games": {
            "format": "int64",
            "type": "integer"
          },
          "order": {
            "type": "string"
          },
          "winRate": {
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "order",
          "games",
          "winRate"
        ],
        "type": "object"
      },
      "BuildSpellOption": {
        "description": "A summoner spell pair, `spellA <= spellB`.",
        "properties": {
          "games": {
            "format": "int64",
            "type": "integer"
          },
          "spellA": {
            "format": "int64",
            "type": "integer"
          },
          "spellB": {
            "format": "int64",
            "type": "integer"
          },
          "winRate": {
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "spellA",
          "spellB",
          "games",
          "winRate"
        ],
        "type": "object"
      },
      "BuildStarterOption": {
        "description": "A starter: the items bought before 60 s, trinkets left out, sorted.",
        "properties": {
          "games": {
            "format": "int64",
            "type": "integer"
          },
          "items": {
            "items": {
              "format": "int64",
              "type": "integer"
            },
            "type": "array"
          },
          "winRate": {
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "items",
          "games",
          "winRate"
        ],
        "type": "object"
      },
      "CacheCounts": {
        "properties": {
          "hit": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "miss": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "neg": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "stale": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "hit",
          "miss",
          "neg",
          "stale"
        ],
        "type": "object"
      },
      "CacheProbe": {
        "description": "What the cache holds for one request.",
        "properties": {
          "ageSeconds": {
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "key": {
            "type": "string"
          },
          "present": {
            "type": "boolean"
          },
          "stale": {
            "description": "Past its soft TTL (served as `STALE`), or null when absent.",
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "key",
          "present",
          "ageSeconds",
          "stale"
        ],
        "type": "object"
      },
      "ChampionBuildEntry": {
        "description": "One set build (BLD-03): its two core items, then what its players chose\nat each later step, at most three options each, most played first.",
        "properties": {
          "boots": {
            "items": {
              "$ref": "#/components/schemas/BuildItemOption"
            },
            "type": "array"
          },
          "core": {
            "description": "The first two finished items, in purchase order.",
            "items": {
              "format": "int64",
              "type": "integer"
            },
            "type": "array"
          },
          "games": {
            "format": "int64",
            "type": "integer"
          },
          "next": {
            "description": "The 3rd, 4th and 5th finished items: three lists, each possibly empty.",
            "items": {
              "items": {
                "$ref": "#/components/schemas/BuildItemOption"
              },
              "type": "array"
            },
            "type": "array"
          },
          "pickRate": {
            "description": "The build's share of the champion's games that had a build (`totalGames`).",
            "format": "double",
            "type": "number"
          },
          "runes": {
            "items": {
              "$ref": "#/components/schemas/BuildRuneOption"
            },
            "type": "array"
          },
          "skillOrder": {
            "items": {
              "$ref": "#/components/schemas/BuildSkillOrderOption"
            },
            "type": "array"
          },
          "spells": {
            "items": {
              "$ref": "#/components/schemas/BuildSpellOption"
            },
            "type": "array"
          },
          "starter": {
            "items": {
              "$ref": "#/components/schemas/BuildStarterOption"
            },
            "type": "array"
          },
          "winRate": {
            "format": "double",
            "type": "number"
          },
          "wins": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "core",
          "games",
          "wins",
          "winRate",
          "pickRate",
          "next",
          "starter",
          "boots",
          "skillOrder",
          "runes",
          "spells"
        ],
        "type": "object"
      },
      "ChampionBuildsResponse": {
        "description": "A champion's set builds in one role (BLD-03).",
        "properties": {
          "builds": {
            "description": "Most played first.",
            "items": {
              "$ref": "#/components/schemas/ChampionBuildEntry"
            },
            "type": "array"
          },
          "championId": {
            "format": "int64",
            "type": "integer"
          },
          "championName": {
            "type": [
              "string",
              "null"
            ]
          },
          "computedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "patch": {
            "type": [
              "string",
              "null"
            ]
          },
          "platform": {
            "description": "`null` when the request named no platform: every platform summed.",
            "type": [
              "string",
              "null"
            ]
          },
          "queue": {
            "type": "string"
          },
          "role": {
            "description": "The role asked for, else the champion's most-played role in the slice;\n`null` when it has no games.",
            "type": [
              "string",
              "null"
            ]
          },
          "totalGames": {
            "description": "The champion's games in this role that had a build: `pickRate`'s denominator.",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "championId",
          "platform",
          "queue",
          "patch",
          "role",
          "computedAt",
          "totalGames",
          "builds"
        ],
        "type": "object"
      },
      "ChampionDetailResponse": {
        "description": "v1 `ChampionDetailResponse`.",
        "properties": {
          "championId": {
            "format": "int64",
            "type": "integer"
          },
          "championName": {
            "type": [
              "string",
              "null"
            ]
          },
          "computedAt": {
            "description": "The oldest section's recompute time: how fresh the whole document is.",
            "type": [
              "string",
              "null"
            ]
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/ChampionItemEntry"
            },
            "type": "array"
          },
          "matchups": {
            "items": {
              "$ref": "#/components/schemas/ChampionMatchupEntry"
            },
            "type": "array"
          },
          "patch": {
            "type": [
              "string",
              "null"
            ]
          },
          "platform": {
            "description": "`null` when the request named no platform: every platform summed.",
            "type": [
              "string",
              "null"
            ]
          },
          "queue": {
            "type": "string"
          },
          "role": {
            "type": [
              "string",
              "null"
            ]
          },
          "runes": {
            "items": {
              "$ref": "#/components/schemas/ChampionRuneEntry"
            },
            "type": "array"
          },
          "sectionsComputedAt": {
            "$ref": "#/components/schemas/SectionsComputedAt"
          },
          "spells": {
            "items": {
              "$ref": "#/components/schemas/ChampionSpellEntry"
            },
            "type": "array"
          },
          "stats": {
            "items": {
              "$ref": "#/components/schemas/ChampionStatEntry"
            },
            "type": "array"
          },
          "tier": {
            "type": [
              "string",
              "null"
            ]
          },
          "totalGames": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "championId",
          "platform",
          "queue",
          "tier",
          "patch",
          "role",
          "computedAt",
          "sectionsComputedAt",
          "totalGames",
          "stats",
          "matchups",
          "items",
          "runes",
          "spells"
        ],
        "type": "object"
      },
      "ChampionItemEntry": {
        "properties": {
          "games": {
            "format": "int64",
            "type": "integer"
          },
          "itemId": {
            "format": "int64",
            "type": "integer"
          },
          "winRate": {
            "format": "double",
            "type": "number"
          },
          "wins": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "itemId",
          "games",
          "wins",
          "winRate"
        ],
        "type": "object"
      },
      "ChampionMasteryDto": {
        "description": "champion-mastery-v4 `ChampionMasteryDto`: one champion's mastery.",
        "properties": {
          "championId": {
            "description": "Champion ID for this entry.",
            "format": "int64",
            "type": "integer"
          },
          "championLevel": {
            "description": "Champion level for specified player and champion combination.",
            "format": "int32",
            "type": "integer"
          },
          "championPoints": {
            "description": "Total number of champion points for this player and champion combination.",
            "format": "int32",
            "type": "integer"
          },
          "championPointsSinceLastLevel": {
            "description": "Number of points earned since current level has been achieved.",
            "format": "int64",
            "type": "integer"
          },
          "championPointsUntilNextLevel": {
            "description": "Number of points needed to achieve next level. Zero if player reached\nmaximum champion level for this champion.",
            "format": "int64",
            "type": "integer"
          },
          "championSeasonMilestone": {
            "format": "int32",
            "type": "integer"
          },
          "chestGranted": {
            "description": "Is chest granted for this champion or not in current season. Not in\nevery recorded body.",
            "type": "boolean"
          },
          "lastPlayTime": {
            "description": "Last time this champion was played by this player - in Unix milliseconds time format.",
            "format": "int64",
            "type": "integer"
          },
          "markRequiredForNextLevel": {
            "format": "int32",
            "type": "integer"
          },
          "milestoneGrades": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "nextSeasonMilestone": {
            "$ref": "#/components/schemas/NextSeasonMilestonesDto"
          },
          "puuid": {
            "description": "Player Universal Unique Identifier. Exact length of 78 characters. (Encrypted)",
            "type": "string"
          },
          "tokensEarned": {
            "description": "The token earned for this champion at the current championLevel.",
            "format": "int32",
            "type": "integer"
          }
        },
        "required": [
          "puuid",
          "championPointsUntilNextLevel",
          "championId",
          "lastPlayTime",
          "championLevel",
          "championPoints",
          "championPointsSinceLastLevel",
          "markRequiredForNextLevel",
          "championSeasonMilestone",
          "nextSeasonMilestone",
          "tokensEarned"
        ],
        "type": "object"
