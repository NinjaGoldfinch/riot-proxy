                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Riot's rate limit budget is exhausted (`RATE_LIMITED`, with `Retry-After`)."
          }
        },
        "summary": "A page of match history, summarised",
        "tags": [
          "players"
        ]
      }
    },
    "/v1/players/{puuid}/profile": {
      "get": {
        "description": "Account, summoner, ranked entries and top mastery, fetched concurrently and each cached on its own. A part that fails is `null` and named in `warnings`; only every part failing is a 404. `refresh=true` re-reads every part upstream, at most once a minute per player.",
        "operationId": "profile",
        "parameters": [
          {
            "description": "Encrypted player UUID",
            "in": "path",
            "name": "puuid",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Platform routing value, e.g. `oc1`. Required",
            "in": "query",
            "name": "platform",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "1–20, default 5",
            "in": "query",
            "name": "topMastery",
            "required": false,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "description": "Spend quota to re-read; once a minute per player",
            "in": "query",
            "name": "refresh",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileBody"
                }
              }
            },
            "description": "The profile"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "A parameter failed validation (`VALIDATION`, or `BAD_REGION` for a platform or region)."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing or invalid key."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The key lacks a scope, or the admin IP allowlist refused the caller."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not found."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Your consumer quota is spent (`QUOTA_EXCEEDED`)."
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Riot failed or rejected the proxy's key (`UPSTREAM_ERROR`)."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Riot's rate limit budget is exhausted (`RATE_LIMITED`, with `Retry-After`)."
          }
        },
        "summary": "A player's profile in one call",
        "tags": [
          "players"
        ]
      }
    },
