    "/v1/lol/analytics/champions": {
      "get": {
        "description": "Aggregated from the match archive, with each participant placed at the tier the latest ladder crawl found them at. Recomputed per (platform, queue) when a crawl completes. Sends an `ETag`; a matching `If-None-Match` gets 304. Games Riot flagged as remakes are left out unless `remakes=include`.",
        "operationId": "champions",
        "parameters": [
          {
            "description": "Only this platform's ladder. Omitted sums every platform",
            "in": "query",
            "name": "platform",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "RANKED_SOLO_5x5 or RANKED_FLEX_SR; default the first of `LADDER_QUEUES`",
            "in": "query",
            "name": "queue",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "IRON … CHALLENGER; default every tier",
            "in": "query",
            "name": "tier",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "`major.minor`; default the newest aggregated patch",
            "in": "query",
            "name": "patch",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "TOP, JUNGLE, MIDDLE, BOTTOM, UTILITY or empty; default every role summed",
            "in": "query",
            "name": "role",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "≥ 0; default `AGGREGATE_MIN_GAMES`",
            "in": "query",
            "name": "minGames",
            "required": false,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "description": "1–500, default 200",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "description": "`exclude` (default) or `include`",
            "in": "query",
            "name": "remakes",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChampionStatsResponse"
                }
              }
            },
            "description": "The champions, most played first"
          },
          "304": {
            "description": "Not modified"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "A parameter failed validation (`VALIDATION`, or `BAD_REGION` for a platform or region)."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing or invalid key."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The key lacks a scope, or the admin IP allowlist refused the caller."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not found."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Your consumer quota is spent (`QUOTA_EXCEEDED`)."
          }
        },
        "summary": "Champion pick and win rates by tier",
        "tags": [
          "lol"
        ]
      }
    },
    "/v1/lol/analytics/champions/{championId}": {
      "get": {
        "description": "Sends an `ETag`; a matching `If-None-Match` gets 304. The stat row(s) at this slice plus this champion's top lane matchups, items, runes and summoner spells — one call for a champion page. Each section is independently trimmed by `minGames`/`limit`; a champion nobody has data for yet still returns 200 with empty arrays rather than a 404.",
        "operationId": "champion_detail",
        "parameters": [
          {
            "description": "Champion id, ≥ 1",
            "in": "path",
            "name": "championId",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "description": "Only this platform's ladder. Omitted sums every platform",
            "in": "query",
            "name": "platform",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "RANKED_SOLO_5x5 or RANKED_FLEX_SR",
            "in": "query",
            "name": "queue",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "IRON … CHALLENGER; applies to `stats`",
            "in": "query",
            "name": "tier",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "`major.minor`; default the newest aggregated patch",
            "in": "query",
            "name": "patch",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "TOP, JUNGLE, MIDDLE, BOTTOM, UTILITY or empty",
            "in": "query",
            "name": "role",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "≥ 0; default `AGGREGATE_MIN_GAMES`",
            "in": "query",
            "name": "minGames",
            "required": false,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "description": "1–50, default 10, per section",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "description": "`exclude` (default) or `include`",
            "in": "query",
            "name": "remakes",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
