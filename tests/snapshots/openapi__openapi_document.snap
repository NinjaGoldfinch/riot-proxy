---
source: tests/openapi.rs
expression: doc
---
{
  "components": {
    "schemas": {
      "AdminStats": {
        "description": "Archive and tracking counts (v1's three fields, plus archive size).",
        "properties": {
          "archiveRawBytes": {
            "description": "What they decompress to.",
            "format": "int64",
            "type": "integer"
          },
          "archiveStoredBytes": {
            "description": "Compressed bytes the archive's match bodies take.",
            "format": "int64",
            "type": "integer"
          },
          "archivedMatches": {
            "description": "The whole archive, which is not key-scoped and survives a key rotation.",
            "format": "int64",
            "type": "integer"
          },
          "archivedTimelines": {
            "format": "int64",
            "type": "integer"
          },
          "keyScope": {
            "type": "string"
          },
          "knownPlayers": {
            "description": "Player rows for the current key, tracked or not.",
            "format": "int64",
            "type": "integer"
          },
          "trackedPlayers": {
            "description": "Scoped to the current key: zero right after a rotation.",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "keyScope",
          "archivedMatches",
          "trackedPlayers",
          "knownPlayers",
          "archivedTimelines",
          "archiveStoredBytes",
          "archiveRawBytes"
        ],
        "type": "object"
      },
      "BackfillNotice": {
        "description": "Present when this lookup queued the player's history for archiving.",
        "properties": {
          "jobId": {
            "type": "string"
          },
          "limit": {
            "description": "How far back the walk will go, in matches.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "status": {
            "description": "`queued`, or `already-queued` when another request got there first.",
            "type": "string"
          }
        },
        "required": [
          "jobId",
          "status",
          "limit"
        ],
        "type": "object"
      },
      "CacheProbe": {
        "description": "What the cache holds for one request.",
        "properties": {
          "ageSeconds": {
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "key": {
            "type": "string"
          },
          "present": {
            "type": "boolean"
          },
          "stale": {
            "description": "Past its soft TTL (served as `STALE`), or null when absent.",
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "key",
          "present",
          "ageSeconds",
          "stale"
        ],
        "type": "object"
      },
      "ConsumerList": {
        "properties": {
          "consumers": {
            "items": {
              "$ref": "#/components/schemas/ConsumerSummary"
            },
            "type": "array"
          }
        },
        "required": [
          "consumers"
        ],
        "type": "object"
      },
      "ConsumerSummary": {
        "description": "A consumer, never its key (v1 `ConsumerSummary`).",
        "properties": {
          "createdAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "disabledAt": {
            "description": "Set when the key was revoked; revoked consumers are kept, never deleted.",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "description": "A ULID (v1 used UUIDs).",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "quotaPerMin": {
            "description": "Requests per minute allowed to this consumer.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "scopes": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "name",
          "scopes",
          "quotaPerMin",
          "disabledAt"
        ],
        "type": "object"
      },
      "CreateConsumer": {
        "description": "`POST /v1/admin/consumers` body.",
        "properties": {
          "name": {
            "description": "1–100 characters; unique.",
            "type": "string"
          },
          "quotaPerMin": {
            "description": "1–1 000 000; default 600.",
            "format": "int32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "scopes": {
            "description": "`read` and/or `admin`; default `[\"read\"]`.",
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "CreatedConsumer": {
        "description": "The new consumer and its key, shown exactly once.",
        "properties": {
          "id": {
            "type": "string"
          },
          "key": {
            "description": "The plaintext key. Only its SHA-256 is stored.",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "quotaPerMin": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "scopes": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "warning": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "scopes",
          "quotaPerMin",
          "key",
          "warning"
        ],
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "description": "The request's `X-Request-Id`.",
            "type": [
              "string",
              "null"
            ]
          },
          "retryAfter": {
            "description": "Seconds to wait before retrying; also sent as `Retry-After`.",
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "ErrorCode": {
        "description": "v1's closed set of error codes, serialised verbatim.",
        "enum": [
          "UNAUTHORIZED",
          "FORBIDDEN",
          "QUOTA_EXCEEDED",
          "NOT_FOUND",
          "UPSTREAM_ERROR",
          "RATE_LIMITED",
          "BAD_REGION",
          "VALIDATION",
          "INTERNAL"
        ],
        "type": "string"
      },
      "ErrorResponse": {
        "description": "The error envelope as documented in OpenAPI (v1 `ErrorResponse`, plus `requestId`).",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Health": {
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "type": "object"
      },
      "JobList": {
        "properties": {
          "jobs": {
            "items": {
              "$ref": "#/components/schemas/JobSummary"
            },
            "type": "array"
          }
        },
        "required": [
          "jobs"
        ],
        "type": "object"
      },
      "JobStats": {
        "properties": {
          "kinds": {
            "additionalProperties": {
              "$ref": "#/components/schemas/StateCounts"
            },
            "description": "By kind.",
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "totals": {
            "$ref": "#/components/schemas/StateCounts"
          }
        },
        "required": [
          "kinds",
          "totals"
        ],
        "type": "object"
      },
      "JobSummary": {
        "description": "A row of the durable queue (design/06).",
        "properties": {
          "attempts": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "claimedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "dedupeKey": {
            "type": [
              "string",
              "null"
            ]
          },
          "error": {
            "description": "The last failure, or `cancelled`.",
            "type": [
              "string",
              "null"
            ]
          },
          "finishedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "description": "A ULID.",
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "payload": {
            "type": "object"
          },
          "priority": {
            "description": "Lower runs first (design/06 bands).",
            "format": "int64",
            "type": "integer"
          },
          "runAfter": {
            "description": "Not before this instant; the backoff after a failure.",
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "description": "`pending`, `running`, `done` or `failed`.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "dedupeKey",
          "priority",
          "state",
          "attempts",
          "claimedAt",
          "finishedAt",
          "error",
          "payload"
        ],
        "type": "object"
      },
      "Limits": {
        "description": "One rate-limit bucket (v1 `LimitsResponse`).",
        "properties": {
          "frozenMs": {
            "description": "Milliseconds until a 429-induced freeze on this bucket lifts, or null.",
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "scope": {
            "type": "string"
          },
          "usage": {
            "description": "Per-window usage as the limiter sees it; empty before Riot has named the limits.",
            "items": {
              "$ref": "#/components/schemas/WindowUsage"
            },
            "type": "array"
          }
        },
        "required": [
          "scope",
          "usage",
          "frozenMs"
        ],
        "type": "object"
      },
      "MatchPage": {
        "properties": {
          "backfill": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/BackfillNotice"
              },
              {
                "type": "null"
              }
            ]
          },
          "count": {
            "format": "int64",
            "type": "integer"
          },
          "hasMore": {
            "description": "A full page came back, so there is probably another behind it.",
            "type": "boolean"
          },
          "matchIds": {
            "description": "The id page as Riot returned it, including ids no summary could be built for.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "matchIdsAgeSeconds": {
            "description": "How long the id list has been unchanged.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "matches": {
            "description": "One summary per id that resolved: the requesting player's line in each game.",
            "items": {
              "$ref": "#/components/schemas/MatchSummary"
            },
            "type": "array"
          },
          "platform": {
            "type": "string"
          },
          "puuid": {
            "type": "string"
          },
          "refreshAvailableIn": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "refreshed": {
            "type": "boolean"
          },
          "region": {
            "type": "string"
          },
          "start": {
            "format": "int64",
            "type": "integer"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "puuid",
          "platform",
          "region",
          "start",
          "count",
          "matchIds",
          "matches",
          "hasMore",
          "matchIdsAgeSeconds",
          "backfill",
          "refreshed",
          "refreshAvailableIn",
          "warnings"
        ],
        "type": "object"
      },
      "MatchSummary": {
        "properties": {
          "endOfGameResult": {
            "type": [
              "string",
              "null"
            ]
          },
          "gameCreation": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "gameDuration": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "gameEndTimestamp": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "gameMode": {
            "type": [
              "string",
              "null"
            ]
          },
          "gameVersion": {
            "description": "Which patch this was played on: the Data Dragon version to render it.",
            "type": [
              "string",
              "null"
            ]
          },
          "matchId": {
            "type": "string"
          },
          "player": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/PlayerSummary"
              },
              {
                "type": "null"
              }
            ]
          },
          "queueId": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "matchId"
        ],
        "type": "object"
      },
      "PartAges": {
        "description": "Per part, how long its content has been unchanged; `null` for a failed part.",
        "properties": {
          "account": {
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "league": {
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "mastery": {
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "summoner": {
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "account",
          "summoner",
          "league",
          "mastery"
        ],
        "type": "object"
      },
      "PerksSummary": {
        "description": "Riot's `perks` blob is ~40 lines to convey three icon ids.",
        "properties": {
          "keystone": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "primaryStyle": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "subStyle": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "PlayerChampionEntry": {
        "description": "One champion in a player's pool.",
        "properties": {
          "avgKda": {
            "description": "(kills + assists) / deaths, deaths floored at 1. Absent until a game\ncarries a K/D/A.",
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "championId": {
            "format": "int64",
            "type": "integer"
          },
          "championName": {
            "type": [
              "string",
              "null"
            ]
          },
          "csPerMin": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "games": {
            "format": "int64",
            "type": "integer"
          },
          "lastPlayedAt": {
            "description": "End of the most recent archived game on this champion (ISO 8601).",
            "type": [
              "string",
              "null"
            ]
          },
          "winRate": {
            "format": "double",
            "type": "number"
          },
          "wins": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "championId",
          "games",
          "wins",
          "winRate",
          "lastPlayedAt"
        ],
        "type": "object"
      },
      "PlayerChampions": {
        "description": "A player's champion pool, computed from the archive at read time: a fact\nabout what this deployment has archived, not the player's whole history.",
        "properties": {
          "archivedGames": {
            "description": "Games summed across `champions`.",
            "format": "int64",
            "type": "integer"
          },
          "champions": {
            "items": {
              "$ref": "#/components/schemas/PlayerChampionEntry"
            },
            "type": "array"
          },
          "patch": {
            "description": "Echoes the `patch` filter; null means every patch.",
            "type": [
              "string",
              "null"
            ]
          },
          "platform": {
            "description": "Echoes the `platform` filter; null means every platform.",
            "type": [
              "string",
              "null"
            ]
          },
          "puuid": {
            "type": "string"
          },
          "queue": {
            "description": "Echoes the `queue` filter; null means every queue.",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "puuid",
          "platform",
          "queue",
          "patch",
          "archivedGames",
          "champions"
        ],
        "type": "object"
      },
      "PlayerList": {
        "properties": {
          "players": {
            "items": {
              "$ref": "#/components/schemas/PlayerRecord"
            },
            "type": "array"
          }
        },
        "required": [
          "players"
        ],
        "type": "object"
      },
      "PlayerRecord": {
        "description": "A `players` row (v1 `PlayerSummary`).",
        "properties": {
          "gameName": {
            "type": [
              "string",
              "null"
            ]
          },
          "historyBackfillDepth": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "historyBackfillStartedAt": {
            "description": "Set with `historyBackfilledAt` still null means a walk that died mid-way.",
            "type": [
              "string",
              "null"
            ]
          },
          "historyBackfilledAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "keyScope": {
            "description": "Fingerprint of the Riot key this PUUID was encrypted for.",
            "type": "string"
          },
          "lastSeenMatchId": {
            "description": "Cursor the match poller resumes from.",
            "type": [
              "string",
              "null"
            ]
          },
          "platform": {
            "type": "string"
          },
          "puuid": {
            "type": "string"
          },
          "tagLine": {
            "type": [
              "string",
              "null"
            ]
          },
          "tracked": {
            "type": "boolean"
          },
          "updatedAt": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "puuid",
          "keyScope",
          "platform",
          "gameName",
          "tagLine",
          "tracked",
          "lastSeenMatchId",
          "historyBackfillStartedAt",
          "historyBackfilledAt",
          "historyBackfillDepth"
        ],
        "type": "object"
      },
      "PlayerSummary": {
        "properties": {
          "assists": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "champLevel": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "championId": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "championName": {
            "type": [
              "string",
              "null"
            ]
          },
          "deaths": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "gameEndedInEarlySurrender": {
            "description": "A remake: rendered as neither a win nor a loss.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "goldEarned": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "item0": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "item1": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "item2": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "item3": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "item4": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "item5": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "item6": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "kills": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "neutralMinionsKilled": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "perks": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/PerksSummary"
              },
              {
                "type": "null"
              }
            ]
          },
          "placement": {
            "description": "Arena: there is no win/loss to render, only a placement.",
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "playerSubteamId": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "puuid": {
            "type": [
              "string",
              "null"
            ]
          },
          "summoner1Id": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "summoner2Id": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "teamId": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "teamPosition": {
            "type": [
              "string",
              "null"
            ]
          },
          "totalDamageDealtToChampions": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "totalMinionsKilled": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "visionScore": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "win": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "ProfileBody": {
        "description": "The composite profile. `account`, `summoner`, `league` and `mastery` are\nRiot's payloads verbatim, or `null` if that part failed (see `warnings`).",
        "properties": {
          "account": {
            "description": "Riot's payload, verbatim, or `null` if that part failed; see `warnings`."
          },
          "ageSeconds": {
            "$ref": "#/components/schemas/PartAges",
            "description": "`X-Cache-Age` is the stalest of these."
          },
          "league": {
            "description": "Riot's payload, verbatim, or `null` if that part failed; see `warnings`."
          },
          "mastery": {
            "description": "Riot's payload, verbatim, or `null` if that part failed; see `warnings`."
          },
          "platform": {
            "type": "string"
          },
          "puuid": {
            "type": "string"
          },
          "refreshAvailableIn": {
            "description": "Seconds until another `?refresh=true` is allowed for this player; 0 when now.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "refreshed": {
            "description": "Whether this request won the refresh window and went upstream.",
            "type": "boolean"
          },
          "region": {
            "type": "string"
          },
          "summoner": {
            "description": "Riot's payload, verbatim, or `null` if that part failed; see `warnings`."
          },
          "warnings": {
            "description": "Names each part that could not be fetched.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "puuid",
          "platform",
          "region",
          "account",
          "summoner",
          "league",
          "mastery",
          "ageSeconds",
          "refreshed",
          "refreshAvailableIn",
          "warnings"
        ],
        "type": "object"
      },
      "Purge": {
        "description": "`POST /v1/admin/cache/purge` body.",
        "properties": {
          "pattern": {
            "description": "A Redis-style glob (`*`, `?`, `[…]`) over cache keys, 1–200 characters. Scoped to the\ncurrent key unless it already starts with a key scope.",
            "type": "string"
          }
        },
        "required": [
          "pattern"
        ],
        "type": "object"
      },
      "QueueBackfill": {
        "description": "`POST /v1/admin/backfill` body (v1).",
        "properties": {
          "fetchTimeline": {
            "description": "Default false.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "limit": {
            "description": "1–10 000, default 500.",
            "format": "int32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "platform": {
            "description": "Platform routing value.",
            "type": "string"
          },
          "puuid": {
            "type": "string"
          }
        },
        "required": [
          "puuid",
          "platform"
        ],
        "type": "object"
      },
      "QueueDdragonSync": {
        "description": "`POST /v1/admin/ddragon/sync` body (v1).",
        "properties": {
          "force": {
            "description": "Re-download a patch that is already mirrored. Default false.",
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "Ready": {
        "description": "v1 returned `{ok, redis, postgres, keyScope}`. v2 has one store, so `sqlite` replaces\nthe two backend booleans, and `limiter` says the checkpoint was restored\n(design/07). `keyScope` is v1's (ADR-011).",
        "properties": {
          "keyScope": {
            "type": "string"
          },
          "limiter": {
            "type": "boolean"
          },
          "ok": {
            "type": "boolean"
          },
          "sqlite": {
            "type": "boolean"
          }
        },
        "required": [
          "ok",
          "sqlite",
          "limiter",
          "keyScope"
        ],
        "type": "object"
      },
      "RevokeCache": {
        "description": "`POST /v1/admin/consumers/{id}/revoke-cache` body.",
        "properties": {
          "keyHash": {
            "description": "The key's SHA-256, 64 hex characters.",
            "type": "string"
          }
        },
        "required": [
          "keyHash"
        ],
        "type": "object"
      },
      "StateCounts": {
        "description": "Rows per state, for one kind or all of them.",
        "properties": {
          "done": {
            "format": "int64",
            "type": "integer"
          },
          "failed": {
            "format": "int64",
            "type": "integer"
          },
          "pending": {
            "format": "int64",
            "type": "integer"
          },
          "running": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "pending",
          "running",
          "done",
          "failed"
        ],
        "type": "object"
      },
      "TrackPlayer": {
        "description": "`POST /v1/admin/tracked-players` body: a PUUID, or a Riot ID to resolve.",
        "properties": {
          "gameName": {
            "type": [
              "string",
              "null"
            ]
          },
          "platform": {
            "description": "Platform routing value, e.g. `euw1`.",
            "type": "string"
          },
          "puuid": {
            "type": [
              "string",
              "null"
            ]
          },
          "tagLine": {
            "type": [
              "string",
              "null"
            ]
          },
          "tracked": {
            "description": "Default `true`; `false` records the player without polling it.",
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "platform"
        ],
        "type": "object"
      },
      "TrackedPlayer": {
        "allOf": [
          {
            "$ref": "#/components/schemas/PlayerRecord"
          },
          {
            "properties": {
              "backfill": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/BackfillNotice"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "backfill"
            ],
            "type": "object"
          }
        ],
        "description": "The stored row, plus the history walk tracking queued, if it did (v1 #46)."
      },
      "WindowUsage": {
        "properties": {
          "limit": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "used": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "window": {
            "description": "`limit:seconds`, e.g. `20:1`.",
            "type": "string"
          }
        },
        "required": [
          "window",
          "used",
          "limit"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "description": "A consumer key, `rpx_…`, issued by `riot-proxy key create` or `POST /v1/admin/consumers` and shown exactly once. Only its SHA-256 is stored.",
        "scheme": "bearer",
        "type": "http"
      },
      "tokenQuery": {
        "description": "**WebSocket handshake only.** A browser `WebSocket` cannot set an `Authorization` header, so `/v1/ws` takes the same key as `?token=`. Avoid it on HTTP routes: a key in a query string ends up in access logs.",
        "in": "query",
        "name": "token",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "A self-hosted proxy between [Riot's public API](https://developer.riotgames.com/) and everything downstream of it. It holds one Riot key, spends it carefully, and gives its consumers their own keys and quotas.\n\n- **Rate limits:** read from Riot's own response headers. Requests a user is waiting on go ahead of background work.\n- **Caching and archive:** repeated reads are served from cache; matches are immutable and archived.\n- **One error envelope:** `{\"error\":{\"code\",\"message\",\"requestId\",\"retryAfter?\"}}`.\n\n### Response headers\n\n| Header | Meaning |\n|---|---|\n| `X-Cache` | `HIT`, `MISS`, `STALE`, `HIT-NEG` (a cached 404), `ARCHIVE` (from the match archive), `BYPASS` (`?refresh=true`) |\n| `X-Cache-Age` | Age of the **content** in seconds, not of the last fetch |\n| `X-RateLimit-Limit` / `-Remaining` / `-Reset` | Your consumer quota |\n| `X-Request-Id` | Quote this when reporting a problem |\n",
    "license": {
      "identifier": "MIT",
      "name": "MIT"
    },
    "title": "riot-proxy",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "description": "Answers as long as the process is up. It touches nothing, so a 200 says only that the process is serving; use `/readyz` to decide whether to send traffic.",
        "operationId": "healthz",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Up"
          }
        },
        "security": [
          {}
        ],
        "summary": "Liveness",
        "tags": [
          "ops"
        ]
      }
    },
    "/metrics": {
      "get": {
        "description": "Prometheus text exposition format, not JSON. Behind a reverse proxy, restrict this path to private ranges.",
        "operationId": "render_metrics",
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Prometheus text exposition format"
          }
        },
        "security": [
          {}
        ],
        "summary": "Prometheus metrics",
        "tags": [
          "ops"
        ]
      }
    },
    "/readyz": {
      "get": {
        "description": "SQLite can take a write and the limiter checkpoint is restored. **The 503 carries the same body as the 200**, so the booleans name what is not ready.",
        "operationId": "readyz",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ready"
                }
              }
            },
            "description": "Ready"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ready"
                }
              }
            },
            "description": "Not ready"
          }
        },
        "security": [
          {}
        ],
        "summary": "Readiness",
        "tags": [
          "ops"
        ]
      }
    },
    "/v1/admin/backfill": {
      "post": {
        "description": "Queues `backfill:player` for one player (v1). One walk per player runs at a time.",
        "operationId": "queue_backfill",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueueBackfill"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "`{ok, jobId, status}`"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "A parameter failed validation (`VALIDATION`, or `BAD_REGION` for a platform or region)."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing or invalid key."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The key lacks a scope, or the admin IP allowlist refused the caller."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not found."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Your consumer quota is spent (`QUOTA_EXCEEDED`)."
          }
        },
        "summary": "Queue a history walk",
        "tags": [
          "admin"
        ]
      }
    },
    "/v1/admin/cache/purge": {
      "post": {
        "description": "Removes matching entries from memory and from the persisted cache. Keys look like `{keyScope}:{endpointId}:{host}:{params…}`, e.g. `summoner.byPuuid:*`. The match archive is not a cache and is never purged.",
        "operationId": "purge_cache",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Purge"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "`{ok, pattern, deleted}`"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "A parameter failed validation (`VALIDATION`, or `BAD_REGION` for a platform or region)."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing or invalid key."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The key lacks a scope, or the admin IP allowlist refused the caller."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not found."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Your consumer quota is spent (`QUOTA_EXCEEDED`)."
          }
        },
        "summary": "Purge cache entries by pattern",
        "tags": [
          "admin"
        ]
      }
    },
    "/v1/admin/consumers": {
      "get": {
        "description": "Every consumer, including revoked ones (`disabledAt` tells them apart). Keys are never returned: only their SHA-256 is stored, and not even that is exposed here.",
        "operationId": "list_consumers",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsumerList"
                }
              }
            },
            "description": "The consumers"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "A parameter failed validation (`VALIDATION`, or `BAD_REGION` for a platform or region)."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing or invalid key."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The key lacks a scope, or the admin IP allowlist refused the caller."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not found."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Your consumer quota is spent (`QUOTA_EXCEEDED`)."
          }
        },
        "summary": "List consumers",
        "tags": [
          "admin"
        ]
      },
      "post": {
        "description": "Issues a key. The plaintext key is in this response and nowhere else: only its SHA-256 is stored.",
        "operationId": "create_consumer",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateConsumer"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedConsumer"
                }
              }
            },
            "description": "The consumer and its key"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "A parameter failed validation (`VALIDATION`, or `BAD_REGION` for a platform or region)."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing or invalid key."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The key lacks a scope, or the admin IP allowlist refused the caller."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not found."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Your consumer quota is spent (`QUOTA_EXCEEDED`)."
          }
        },
        "summary": "Create a consumer",
        "tags": [
          "admin"
        ]
      }
    },
    "/v1/admin/consumers/{id}": {
      "delete": {
        "description": "The key stops working immediately: it is also dropped from the auth cache. The row is kept, so the key can never be reissued.",
        "operationId": "revoke_consumer",
        "parameters": [
          {
            "description": "Consumer id (a ULID)",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "`{ok, id}`"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "A parameter failed validation (`VALIDATION`, or `BAD_REGION` for a platform or region)."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing or invalid key."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The key lacks a scope, or the admin IP allowlist refused the caller."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not found."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Your consumer quota is spent (`QUOTA_EXCEEDED`)."
          }
        },
        "summary": "Revoke a consumer",
        "tags": [
          "admin"
        ]
      }
    },
    "/v1/admin/consumers/{id}/revoke-cache": {
      "post": {
        "description": "Forces the next request with this key to be re-checked against the database. The key hash must belong to the consumer in the path. Revoking a consumer already does this.",
        "operationId": "revoke_cache",
        "parameters": [
          {
            "description": "Consumer id (a ULID)",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RevokeCache"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "`{ok, id, stillActive}`"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "A parameter failed validation (`VALIDATION`, or `BAD_REGION` for a platform or region)."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing or invalid key."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The key lacks a scope, or the admin IP allowlist refused the caller."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not found."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Your consumer quota is spent (`QUOTA_EXCEEDED`)."
          }
        },
        "summary": "Drop a key from the auth cache",
        "tags": [
          "admin"
        ]
      }
    },
    "/v1/admin/ddragon/sync": {
      "post": {
        "description": "Queues `ddragon:sync` (v1). Without `force` it joins the hourly tick's job when one is queued; a `force` sync is queued once beside it.",
        "operationId": "queue_ddragon_sync",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueueDdragonSync"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "`{ok, jobId}`"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "A parameter failed validation (`VALIDATION`, or `BAD_REGION` for a platform or region)."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing or invalid key."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The key lacks a scope, or the admin IP allowlist refused the caller."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not found."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Your consumer quota is spent (`QUOTA_EXCEEDED`)."
          }
        },
        "summary": "Queue a Data Dragon sync",
        "tags": [
          "admin"
        ]
      }
    },
    "/v1/admin/debug/cache": {
      "get": {
        "description": "What the proxy has cached for a request, without fetching it: the key, whether an entry is present, its age and whether it is stale.",
        "operationId": "debug_cache",
        "parameters": [
          {
            "description": "Platform or region, e.g. euw1 or europe",
            "in": "query",
            "name": "scope",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Riot path starting with `/`",
            "in": "query",
            "name": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Endpoint id, e.g. summoner.byPuuid",
            "in": "query",
            "name": "method",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CacheProbe"
                }
              }
            },
            "description": "The entry"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "A parameter failed validation (`VALIDATION`, or `BAD_REGION` for a platform or region)."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing or invalid key."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
