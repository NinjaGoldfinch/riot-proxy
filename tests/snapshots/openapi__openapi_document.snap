    "/v1/static/{file}": {
      "get": {
        "description": "Data Dragon's JSON for the mirrored patch, or for `?version=` when that patch was mirrored. Plural aliases name the same files (`champions` is `champion`).",
        "operationId": "static_file",
        "parameters": [
          {
            "description": "Data Dragon name or alias",
            "in": "path",
            "name": "file",
            "required": true,
            "schema": {
              "description": "`/v1/static/{file}`'s names, for the document (v1's enum, in its order).",
              "enum": [
                "champion",
                "item",
                "runesReforged",
                "summoner",
                "profileicon",
                "map",
                "champions",
                "items",
                "runes",
                "summoner-spells",
                "profile-icons",
                "maps"
              ],
              "type": "string"
            }
          },
          {
            "description": "A mirrored patch; default the current one",
            "example": "16.17.1",
            "in": "query",
            "name": "version",
            "required": false,
            "schema": {
              "maxLength": 20,
              "pattern": "^[0-9]+(\\.[0-9]+)*$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Data Dragon's JSON, untouched"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "A parameter failed validation (`VALIDATION`, or `BAD_REGION` for a platform or region)."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing or invalid key."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The key lacks a scope, or the admin IP allowlist refused the caller."
          },
          "404": {
            "content": {
