      "ProbeBody": {
        "description": "`POST /v1/admin/ladder/probe` body.",
        "properties": {
          "platform": {
            "description": "Platform routing value.",
            "type": "string"
          },
          "queue": {
            "description": "`RANKED_SOLO_5x5` or `RANKED_FLEX_SR`; default the first of `LADDER_QUEUES`.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "platform"
        ],
        "type": "object"
      },
      "ProcessStats": {
        "properties": {
          "rssBytes": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "uptimeSeconds": {
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "uptimeSeconds",
          "rssBytes"
        ],
        "type": "object"
      },
      "ProfileBody": {
        "description": "The composite profile. `account`, `summoner`, `league` and `mastery` are\nRiot's payloads verbatim, or `null` if that part failed (see `warnings`).",
        "properties": {
          "account": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/AccountDto",
                "description": "Riot's payload, verbatim, or `null` if that part failed; see `warnings`."
              },
              {
                "type": "null"
              }
            ]
          },
          "ageSeconds": {
            "$ref": "#/components/schemas/PartAges",
            "description": "How long each part's content has been unchanged: a refetch that returns\nthe same bytes does not reset it. `X-Cache-Age` is the stalest of these."
          },
          "fetchedAgeSeconds": {
            "$ref": "#/components/schemas/PartAges",
            "description": "How long ago each part was last read from Riot, whether or not it\nchanged. `X-Cache-Fetched-Age` is the stalest of these."
          },
          "league": {
            "description": "Riot's payload, verbatim, or `null` if that part failed; see `warnings`.",
            "items": {
              "$ref": "#/components/schemas/LeagueEntryDTO"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "mastery": {
            "description": "Riot's payload, verbatim, or `null` if that part failed; see `warnings`.",
            "items": {
              "$ref": "#/components/schemas/ChampionMasteryDto"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "platform": {
            "type": "string"
          },
          "puuid": {
            "type": "string"
          },
          "refreshAvailableIn": {
            "description": "Seconds until another `?refresh=true` is allowed for this player; 0 when now.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "refreshed": {
            "description": "Whether this request won the refresh window and went upstream.",
            "type": "boolean"
          },
          "region": {
            "type": "string"
          },
          "summoner": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/SummonerDTO",
                "description": "Riot's payload, verbatim, or `null` if that part failed; see `warnings`."
              },
              {
                "type": "null"
              }
            ]
          },
          "warnings": {
            "description": "Names each part that could not be fetched.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "puuid",
          "platform",
          "region",
          "account",
          "summoner",
          "league",
          "mastery",
          "ageSeconds",
          "fetchedAgeSeconds",
          "refreshed",
          "refreshAvailableIn",
          "warnings"
        ],
        "type": "object"
      },
      "Purge": {
        "description": "`POST /v1/admin/cache/purge` body.",
        "properties": {
          "pattern": {
            "description": "A Redis-style glob (`*`, `?`, `[…]`) over cache keys, 1–200 characters. Scoped to the\ncurrent key unless it already starts with a key scope.",
            "type": "string"
          }
        },
        "required": [
          "pattern"
        ],
        "type": "object"
      },
      "QueueBackfill": {
        "description": "`POST /v1/admin/backfill` body (v1).",
        "properties": {
          "fetchTimeline": {
            "description": "Default false.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "limit": {
            "description": "1–10 000, default 500.",
            "format": "int32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "platform": {
            "description": "Platform routing value.",
            "type": "string"
          },
          "puuid": {
            "type": "string"
          }
        },
        "required": [
          "puuid",
          "platform"
        ],
        "type": "object"
      },
      "QueueCount": {
        "description": "Archived matches in one queue.",
        "properties": {
          "matches": {
            "format": "int64",
