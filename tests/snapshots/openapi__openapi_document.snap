    "/v1/lol/analytics/champions": {
      "get": {
        "description": "Aggregated from every archived match on the platform. Each participant is placed at the tier the ladder crawl or the latest league lookup of that player found them at, whichever is newer, and under `UNKNOWN` when neither has. Recomputed per (platform, queue) when a crawl completes. Sends an `ETag`; a matching `If-None-Match` gets 304. Games Riot flagged as remakes are left out unless `remakes=include`.",
        "operationId": "champions",
        "parameters": [
          {
            "description": "Only this platform's ladder. Omitted sums every platform",
            "in": "query",
            "name": "platform",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "RANKED_SOLO_5x5 or RANKED_FLEX_SR; default the first of `LADDER_QUEUES`",
            "in": "query",
            "name": "queue",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "IRON … CHALLENGER, or UNKNOWN; default every tier",
            "in": "query",
            "name": "tier",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "`major.minor`, or `all` to sum every aggregated patch; default the newest aggregated patch",
            "in": "query",
            "name": "patch",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "TOP, JUNGLE, MIDDLE, BOTTOM, UTILITY or empty; default every role summed",
            "in": "query",
            "name": "role",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "≥ 0; default `AGGREGATE_MIN_GAMES`",
            "in": "query",
            "name": "minGames",
            "required": false,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "description": "1–500, default 200",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "description": "`exclude` (default) or `include`",
            "in": "query",
            "name": "remakes",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChampionStatsResponse"
                }
              }
            },
            "description": "The champions, most played first",
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/X-RateLimit-Limit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/X-RateLimit-Remaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/X-RateLimit-Reset"
              },
              "X-Request-Id": {
                "$ref": "#/components/headers/X-Request-Id"
              }
            }
          },
          "304": {
            "description": "Not modified",
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/X-RateLimit-Limit"
              },
              "X-RateLimit-Remaining": {
