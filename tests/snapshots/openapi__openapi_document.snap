    "/v1/admin/debug/riot": {
      "get": {
        "description": "Fetch any Riot path on a platform or region host, through the limiter and cache like any read. `method` picks the endpoint whose bucket, TTL and cache key apply, and the path must then be that endpoint's route; without it, a conservative default bucket is used. `noCache=true` skips the cache read.",
        "operationId": "debug_riot",
        "parameters": [
          {
            "description": "Platform or region, e.g. euw1 or europe",
            "in": "query",
            "name": "scope",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Riot path starting with `/`, query string allowed",
            "in": "query",
            "name": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Endpoint id, e.g. summoner.byPuuid",
            "in": "query",
            "name": "method",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Skip the cache read",
            "in": "query",
            "name": "noCache",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {}
            },
            "description": "Riot's payload, unmodified. `X-Cache` and `X-Cache-Age` describe where it came from."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "A parameter failed validation (`VALIDATION`, or `BAD_REGION` for a platform or region)."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing or invalid key."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The key lacks a scope."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not found upstream; a cached 404 carries `X-Cache: HIT-NEG`."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Your consumer quota is spent (`QUOTA_EXCEEDED`)."
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Riot failed or rejected the proxy's key (`UPSTREAM_ERROR`)."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Riot's rate limit budget is exhausted (`RATE_LIMITED`, with `Retry-After`)."
          }
        },
        "summary": "Raw Riot passthrough",
        "tags": [
          "admin"
        ]
      }
    },
