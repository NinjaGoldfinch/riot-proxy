    "/v1/lol/league/entries/{platform}/{queue}/{tier}/{division}": {
      "get": {
        "description": "One ~205-entry page of the ladder. Pages are 1-based; a page past the end of the division returns an empty array rather than a 404.",
        "operationId": "league_entries_page",
        "parameters": [
          {
            "description": "Platform routing value",
            "in": "path",
            "name": "platform",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "RANKED_SOLO_5x5 or RANKED_FLEX_SR",
            "in": "path",
            "name": "queue",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "IRON … DIAMOND (apex tiers have their own route)",
            "in": "path",
            "name": "tier",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "I … IV",
            "in": "path",
            "name": "division",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "1-based page, default 1 (max 100000)",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
