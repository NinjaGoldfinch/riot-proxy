---
source: tests/openapi.rs
expression: doc
---
{
  "components": {
    "schemas": {
      "AdminStats": {
        "description": "Archive and tracking counts (v1's three fields, plus archive size).",
        "properties": {
          "archiveRawBytes": {
            "description": "What they decompress to.",
            "format": "int64",
            "type": "integer"
          },
          "archiveStoredBytes": {
            "description": "Compressed bytes the archive's match bodies take.",
            "format": "int64",
            "type": "integer"
          },
          "archivedMatches": {
            "description": "The whole archive, which is not key-scoped and survives a key rotation.",
            "format": "int64",
            "type": "integer"
          },
          "archivedTimelines": {
            "format": "int64",
            "type": "integer"
          },
          "keyScope": {
            "type": "string"
          },
          "knownPlayers": {
            "description": "Player rows for the current key, tracked or not.",
            "format": "int64",
            "type": "integer"
          },
          "trackedPlayers": {
            "description": "Scoped to the current key: zero right after a rotation.",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "keyScope",
          "archivedMatches",
          "trackedPlayers",
          "knownPlayers",
          "archivedTimelines",
          "archiveStoredBytes",
          "archiveRawBytes"
        ],
        "type": "object"
      },
      "AnalyticsSection": {
        "properties": {
          "lastRuns": {
            "items": {
              "$ref": "#/components/schemas/RunSummary"
            },
            "type": "array"
          },
          "topChampions": {
            "description": "The newest run's ladder, its latest patch, top five by games.",
            "items": {
              "$ref": "#/components/schemas/TopChampion"
            },
            "type": "array"
          }
        },
        "required": [
          "lastRuns",
          "topChampions"
        ],
        "type": "object"
      },
      "ArchiveTotals": {
        "description": "What the archive holds for one player: exact counts from `match_facts`.",
        "properties": {
          "byQueue": {
            "description": "Most matches first.",
            "items": {
              "$ref": "#/components/schemas/QueueCount"
            },
            "type": "array"
          },
          "matches": {
            "format": "int64",
            "type": "integer"
          },
          "newestGameEnd": {
            "type": [
              "string",
              "null"
            ]
          },
          "oldestGameEnd": {
            "type": [
              "string",
              "null"
            ]
          },
          "remakes": {
            "description": "Matches Riot flagged as remakes; counted in `matches`.",
            "format": "int64",
            "type": "integer"
          },
          "timelines": {
            "description": "Of `matches`, how many also have a stored timeline.",
            "format": "int64",
            "type": "integer"
          },
          "wins": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "matches",
          "remakes",
          "wins",
          "timelines",
          "oldestGameEnd",
          "newestGameEnd",
          "byQueue"
        ],
        "type": "object"
      },
      "ArchivedLine": {
        "description": "The player's line in one archived match.",
        "properties": {
          "assists": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "championId": {
            "format": "int64",
            "type": "integer"
          },
          "cs": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "deaths": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "gameDuration": {
            "description": "Seconds.",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "gameEndTimestamp": {
            "format": "int64",
            "type": "integer"
          },
          "kills": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "matchId": {
            "type": "string"
          },
          "position": {
            "type": [
              "string",
              "null"
            ]
          },
          "queueId": {
            "format": "int64",
            "type": "integer"
          },
          "remake": {
            "description": "Null until the match's facts have been re-extracted (V0005).",
            "type": [
              "boolean",
              "null"
            ]
          },
          "win": {
            "type": "boolean"
          }
        },
        "required": [
          "matchId",
          "queueId",
          "gameEndTimestamp",
          "gameDuration",
          "remake",
          "championId",
          "position",
          "win",
          "kills",
          "deaths",
          "assists",
          "cs"
        ],
        "type": "object"
      },
      "ArchivedPage": {
        "description": "`GET /v1/admin/players/{puuid}/archive/matches`.",
        "properties": {
          "count": {
            "format": "int64",
            "type": "integer"
          },
          "matches": {
            "items": {
              "$ref": "#/components/schemas/ArchivedLine"
            },
            "type": "array"
          },
          "puuid": {
            "type": "string"
          },
          "start": {
            "format": "int64",
            "type": "integer"
          },
          "total": {
            "description": "Every archived match for this player and filter, not just this page.",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "puuid",
          "total",
          "start",
          "count",
          "matches"
        ],
        "type": "object"
      },
      "BackfillNotice": {
        "description": "Present when this lookup queued the player's history for archiving.",
        "properties": {
          "jobId": {
            "type": "string"
          },
          "limit": {
            "description": "How far back the walk will go, in matches.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "status": {
            "description": "`queued`, or `already-queued` when another request got there first.",
            "type": "string"
          }
        },
        "required": [
          "jobId",
          "status",
          "limit"
        ],
        "type": "object"
      },
      "CacheCounts": {
        "properties": {
          "hit": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "miss": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "neg": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "stale": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "hit",
          "miss",
          "neg",
          "stale"
        ],
        "type": "object"
      },
      "CacheProbe": {
        "description": "What the cache holds for one request.",
        "properties": {
          "ageSeconds": {
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "key": {
            "type": "string"
          },
          "present": {
            "type": "boolean"
          },
          "stale": {
            "description": "Past its soft TTL (served as `STALE`), or null when absent.",
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "key",
          "present",
          "ageSeconds",
          "stale"
        ],
        "type": "object"
      },
      "ChampionDetailResponse": {
        "description": "v1 `ChampionDetailResponse`.",
        "properties": {
          "championId": {
            "format": "int64",
            "type": "integer"
          },
          "championName": {
            "type": [
              "string",
              "null"
            ]
          },
          "computedAt": {
            "description": "The oldest section's recompute time: how fresh the whole document is.",
            "type": [
              "string",
              "null"
            ]
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/ChampionItemEntry"
            },
            "type": "array"
          },
          "matchups": {
            "items": {
              "$ref": "#/components/schemas/ChampionMatchupEntry"
            },
            "type": "array"
          },
          "patch": {
            "type": [
              "string",
              "null"
            ]
          },
          "platform": {
            "description": "`null` when the request named no platform: every platform summed.",
            "type": [
              "string",
              "null"
            ]
          },
          "queue": {
            "type": "string"
          },
          "role": {
            "type": [
              "string",
              "null"
            ]
          },
          "runes": {
            "items": {
              "$ref": "#/components/schemas/ChampionRuneEntry"
            },
            "type": "array"
          },
          "sectionsComputedAt": {
            "$ref": "#/components/schemas/SectionsComputedAt"
          },
          "spells": {
            "items": {
              "$ref": "#/components/schemas/ChampionSpellEntry"
            },
            "type": "array"
          },
          "stats": {
            "items": {
              "$ref": "#/components/schemas/ChampionStatEntry"
            },
            "type": "array"
          },
          "tier": {
            "type": [
              "string",
              "null"
            ]
          },
          "totalGames": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "championId",
          "platform",
          "queue",
          "tier",
          "patch",
          "role",
          "computedAt",
          "sectionsComputedAt",
          "totalGames",
          "stats",
          "matchups",
          "items",
          "runes",
          "spells"
        ],
        "type": "object"
      },
      "ChampionItemEntry": {
        "properties": {
          "games": {
            "format": "int64",
            "type": "integer"
          },
          "itemId": {
            "format": "int64",
            "type": "integer"
          },
          "winRate": {
            "format": "double",
            "type": "number"
          },
          "wins": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "itemId",
          "games",
          "wins",
          "winRate"
        ],
        "type": "object"
      },
      "ChampionMatchupEntry": {
        "description": "v1 `ChampionMatchupEntry`.",
        "properties": {
          "games": {
            "format": "int64",
            "type": "integer"
          },
          "opponentId": {
            "format": "int64",
            "type": "integer"
          },
          "opponentName": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "type": "string"
          },
          "winRate": {
            "format": "double",
            "type": "number"
          },
          "wins": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "role",
          "opponentId",
          "games",
          "wins",
          "winRate"
        ],
        "type": "object"
      },
      "ChampionMatchupsResponse": {
        "description": "v1 `ChampionMatchupsResponse`.",
        "properties": {
          "championId": {
            "format": "int64",
            "type": "integer"
          },
          "championName": {
            "type": [
              "string",
              "null"
            ]
          },
          "computedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "matchups": {
            "items": {
              "$ref": "#/components/schemas/ChampionMatchupEntry"
            },
            "type": "array"
          },
          "patch": {
            "type": [
              "string",
              "null"
            ]
          },
          "platform": {
            "description": "`null` when the request named no platform: every platform summed.",
            "type": [
              "string",
              "null"
            ]
          },
          "queue": {
            "type": "string"
          },
          "role": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "championId",
          "platform",
          "queue",
          "patch",
          "role",
          "computedAt",
          "matchups"
        ],
        "type": "object"
      },
      "ChampionRuneEntry": {
        "properties": {
          "games": {
            "format": "int64",
            "type": "integer"
          },
          "keystoneId": {
            "format": "int64",
            "type": "integer"
          },
          "subStyleId": {
            "format": "int64",
            "type": "integer"
          },
          "winRate": {
            "format": "double",
            "type": "number"
          },
          "wins": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "keystoneId",
          "subStyleId",
          "games",
          "wins",
          "winRate"
        ],
        "type": "object"
      },
      "ChampionSpellEntry": {
        "properties": {
          "games": {
            "format": "int64",
            "type": "integer"
          },
          "spellA": {
            "format": "int64",
            "type": "integer"
          },
          "spellB": {
            "format": "int64",
            "type": "integer"
          },
          "winRate": {
            "format": "double",
            "type": "number"
          },
          "wins": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "spellA",
          "spellB",
          "games",
          "wins",
          "winRate"
        ],
        "type": "object"
      },
      "ChampionStatEntry": {
        "description": "One champion at one tier (v1 `ChampionStatEntry`).",
        "properties": {
          "avgDamage": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "avgKda": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "avgVision": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "banRate": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "championId": {
            "format": "int64",
            "type": "integer"
          },
          "championName": {
            "type": [
              "string",
              "null"
            ]
          },
          "csPerMin": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "games": {
            "format": "int64",
            "type": "integer"
          },
          "goldPerMin": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "patch": {
            "type": "string"
          },
          "pickRate": {
            "description": "Matches picked over the tier's matches, capped at 1. Absent without a slice.",
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "share": {
            "description": "Of the games in the rows returned.",
            "format": "double",
            "type": "number"
          },
          "tier": {
            "type": "string"
          },
          "winRate": {
            "format": "double",
            "type": "number"
          },
          "wins": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "championId",
          "tier",
          "patch",
          "games",
          "wins",
          "winRate",
          "share"
        ],
        "type": "object"
      },
      "ChampionStatsResponse": {
        "description": "v1 `ChampionStatsResponse`.",
        "properties": {
          "champions": {
            "items": {
              "$ref": "#/components/schemas/ChampionStatEntry"
            },
            "type": "array"
          },
          "computedAt": {
            "description": "The newest row's recompute time.",
            "type": [
              "string",
              "null"
            ]
          },
          "patch": {
            "type": [
              "string",
              "null"
            ]
          },
          "platform": {
            "description": "`null` when the request named no platform: every platform summed.",
            "type": [
              "string",
              "null"
            ]
          },
          "queue": {
            "type": "string"
          },
          "role": {
            "type": [
              "string",
              "null"
            ]
          },
          "tier": {
            "type": [
              "string",
              "null"
            ]
          },
          "totalGames": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "platform",
          "queue",
          "tier",
          "patch",
          "role",
          "computedAt",
          "totalGames",
          "champions"
        ],
        "type": "object"
      },
      "ConsumerList": {
        "properties": {
          "consumers": {
            "items": {
              "$ref": "#/components/schemas/ConsumerSummary"
            },
            "type": "array"
          }
        },
        "required": [
          "consumers"
        ],
        "type": "object"
      },
      "ConsumerSummary": {
        "description": "A consumer, never its key (v1 `ConsumerSummary`).",
        "properties": {
          "createdAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "disabledAt": {
            "description": "Set when the key was revoked; revoked consumers are kept, never deleted.",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "description": "A ULID (v1 used UUIDs).",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "quotaPerMin": {
            "description": "Requests per minute allowed to this consumer.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "scopes": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "name",
          "scopes",
          "quotaPerMin",
          "disabledAt"
        ],
        "type": "object"
      },
      "CrawlActivity": {
        "properties": {
          "ahead": {
            "description": "Ready jobs of any kind a worker takes before this crawl's next one; `null` when it has\nnothing ready.",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "asOf": {
            "type": [
              "string",
              "null"
            ]
          },
          "crawl": {
            "$ref": "#/components/schemas/LadderCrawlSummary"
          },
          "downloads": {
            "$ref": "#/components/schemas/CrawlDownloads"
          },
          "failed": {
            "description": "Its failed jobs, newest first.",
            "items": {
              "$ref": "#/components/schemas/JobSummary"
            },
            "type": "array"
          },
          "next": {
            "description": "Its next jobs in claim order: ready first, then any waiting out a backoff.",
            "items": {
              "$ref": "#/components/schemas/JobSummary"
            },
            "type": "array"
          },
          "openLegs": {
            "description": "Legs still outstanding, with a walk's page.",
            "items": {
              "$ref": "#/components/schemas/OpenWalk"
            },
            "type": "array"
          },
          "running": {
            "description": "This crawl's jobs running now.",
            "items": {
              "$ref": "#/components/schemas/JobSummary"
            },
            "type": "array"
          },
          "stages": {
            "items": {
              "$ref": "#/components/schemas/CrawlStage"
            },
            "type": "array"
          }
        },
        "required": [
          "crawl",
          "asOf",
          "stages",
          "openLegs",
          "running",
          "next",
          "ahead",
          "failed",
          "downloads"
        ],
        "type": "object"
      },
      "CrawlDownloads": {
        "description": "The crawl-found matches being fetched on this crawl's platform. After the hand-off an\n`archive:match` job only names its match, so these count every crawl on the platform.",
        "properties": {
          "delayed": {
            "format": "int64",
            "type": "integer"
          },
          "etaSeconds": {
            "description": "Seconds to fetch what is queued at that pace; `null` when idle.",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "failed": {
            "format": "int64",
            "type": "integer"
          },
          "platform": {
            "type": "string"
          },
          "ready": {
            "format": "int64",
            "type": "integer"
          },
          "recent": {
            "description": "Fetched in the last ten minutes.",
            "format": "int64",
            "type": "integer"
          },
          "running": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "platform",
          "ready",
          "delayed",
          "running",
          "failed",
          "recent",
          "etaSeconds"
        ],
        "type": "object"
      },
      "CrawlStage": {
        "description": "One stage of a crawl and how far through it is.",
        "properties": {
          "done": {
            "description": "Units finished; `null` where it cannot be known (a stage a stopped crawl ended in).",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "etaSeconds": {
            "description": "Seconds left at that pace; `null` when idle or not running.",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "name": {
            "description": "`enumerate`, `collect` or `archive`.",
            "type": "string"
          },
          "recent": {
            "description": "Units this crawl finished in the last ten minutes.",
            "format": "int64",
            "type": "integer"
          },
          "state": {
            "description": "`done`, `now`, `waiting`, or for a crawl that ended early `stopped` (where it ended) and\n`skipped` (never reached).",
            "type": "string"
          },
          "total": {
            "description": "Units in the stage; `null` until the stage before has ended.",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "unit": {
            "description": "`legs` (apex leagues and division walks), `batches` (25 players' match ids) or `ids` (handed\nto the archive queue).",
            "type": "string"
          }
        },
        "required": [
          "name",
          "state",
          "done",
          "total",
          "unit",
          "recent",
          "etaSeconds"
        ],
        "type": "object"
      },
      "CreateConsumer": {
        "description": "`POST /v1/admin/consumers` body.",
        "properties": {
          "name": {
            "description": "1–100 characters; unique.",
            "type": "string"
          },
          "quotaPerMin": {
            "description": "1–1 000 000; default 600.",
            "format": "int32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "scopes": {
            "description": "`read` and/or `admin`; default `[\"read\"]`.",
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "CreatedConsumer": {
        "description": "The new consumer and its key, shown exactly once.",
        "properties": {
          "id": {
            "type": "string"
          },
          "key": {
            "description": "The plaintext key. Only its SHA-256 is stored.",
