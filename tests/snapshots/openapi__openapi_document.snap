            "format": "int64",
            "type": "integer"
          },
          "failed": {
            "description": "Failed in the last 24 hours.",
            "format": "int64",
            "type": "integer"
          },
          "prioritized": {
            "description": "Always 0: every v2 job has a priority, so `waiting` holds them all.",
            "format": "int64",
            "type": "integer"
          },
          "scheduled": {
            "description": "Always 0: v2's ticks are timers, not parked jobs.",
            "format": "int64",
            "type": "integer"
          },
          "waiting": {
            "description": "Pending and due.",
            "format": "int64",
            "type": "integer"
          }
