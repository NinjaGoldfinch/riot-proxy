{
  "name": "riot-proxy",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted middleman API between Riot Games' public API and downstream projects",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "migrate": "tsx src/db/migrate.ts",
    "key:create": "tsx src/cli/create-key.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:acceptance": "vitest run --config vitest.acceptance.config.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.2.0",
    "@sinclair/typebox": "^0.34.33",
    "bullmq": "^5.56.0",
    "dotenv": "^17.2.0",
    "drizzle-orm": "^0.44.2",
    "fastify": "^5.4.0",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^5.6.1",
    "pino": "^9.7.0",
    "postgres": "^3.4.7",
    "prom-client": "^15.1.3",
    "undici": "^7.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.30.0",
    "msw": "^2.10.2",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.4"
  }
}
