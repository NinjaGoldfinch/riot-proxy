# riot-proxy v2 configuration. Copy to .env and set RIOT_API_KEY.
# Precedence: CLI flag > environment > this file > built-in default.
# An empty value (FOO=) means "use the default". Commented lines show the default.

# ─── Riot ────────────────────────────────────────────────────────────────────
# Required. The key this proxy exists to hide. Never commit a real one.
RIOT_API_KEY=
# Sent as User-Agent on every upstream call so Riot can identify you.
# RIOT_USER_AGENT=riot-proxy/2.0 (+https://github.com/NinjaGoldfinch/riot-proxy)

# ─── Service ─────────────────────────────────────────────────────────────────
# development | test | production. Production refuses AUTH_DISABLED and defaults DEV_UI off.
# Replaces v1's NODE_ENV, which is still read when ENV is unset.
# ENV=development
# HOST=0.0.0.0
# PORT=8080
# tracing filter directive, e.g. info or riot_proxy=debug,tower_http=info.
# LOG_LEVEL=info
# json | pretty. Unset: pretty when stdout is a terminal, json otherwise.
# LOG_FORMAT=json
# SQLite database, ddragon mirror and backups all live here. Created if missing.
# DATA_DIR=./data
# Unset: sqlite://$DATA_DIR/riot-proxy.db. postgres:// needs the postgres feature.
# DATABASE_URL=
# all | api | worker. api and worker are only valid with Postgres.
# ROLE=all
# Durable jobs run concurrently by the scheduler.
# JOB_CONCURRENCY=8
# On a 2-vCPU host, 2 workers keep the CPU and SQLite's write lock from
# saturating (docs/design/07 §Sizing).
# The most jobs of a kind that run at once, as kind=n,kind=n. Only kinds that
# don't call Riot (aggregate:analytics, names:backfill, builds:extract, …);
# the rate limiter paces the rest. `none` for no caps.
# JOB_KIND_LIMITS=aggregate:analytics=1
# How long a job waits for the rate limiter before giving its worker to work
# in another region (ms).
# JOB_YIELD_BUDGET_MS=1000

# ─── Behaviour ───────────────────────────────────────────────────────────────
# CSV of TTL overrides in seconds keyed by endpoint id, e.g. league=120,spectator=20.
# CACHE_TTL_OVERRIDES=
# In-memory (L1) response cache budget in MiB; entries are evicted by size beyond it.
# CACHE_L1_MAX_MB=128
# Negative-cache TTL for 404s, and the longer one for account lookups.
# NEG_TTL_SECONDS=30
# NEG_TTL_ACCOUNT_SECONDS=300
# How long an interactive request may wait for a rate-limit token before RATE_LIMITED.
# CLIENT_WAIT_BUDGET_MS=2000
# Bulk work stops at this share of a bucket while someone is using the app;
# 0.80 reserves 20% for interactive requests.
# BULK_USAGE_CEILING=0.80
# Bulk's share while nobody is: a region with no interactive request in the last
# BULK_IDLE_AFTER_S seconds. Must be at least BULK_USAGE_CEILING and below 1.
# BULK_IDLE_CEILING=0.95
# BULK_IDLE_AFTER_S=30
# Serve stale entries while refreshing them in the background.
# STALE_WHILE_REVALIDATE=true
# Tick of the metrics WebSocket topic in seconds; only spent while someone is subscribed.
# METRICS_INTERVAL_S=5
# Cadence of the metrics history the dashboard draws, in seconds; always recorded.
# METRICS_HISTORY_INTERVAL_S=60

# ─── Worker cadence (seconds) ────────────────────────────────────────────────
# TRACK_POLL_LIVE_S=60
# TRACK_POLL_RANK_S=600
# TRACK_POLL_MATCH_S=300
# DDRAGON_SYNC_S=3600
# Archive jobs (ladder crawls, polls, backfills) also fetch match timelines: one more
# request per match, and large. false turns that off. Timelines fetched through the
# API are archived either way.
# ARCHIVE_TIMELINES=true
# timelines:backfill fetches the missing timelines of ranked matches already archived
# (those stored without one), in this many of the newest patches, newest first, at the
# lowest priority: only with rate-limit room nothing else wants. 0 (the default) is off.
# TIMELINE_BACKFILL_PATCHES=0
# Matches walked back the first time a player is looked up; the default (4294967295, the
# largest value) walks until Riot's history runs out. 0 disables.
# LOOKUP_BACKFILL_LIMIT=4294967295
# How far back one match poll pages to find where it left off; 0 is a fixed window.
# TRACK_CATCHUP_LIMIT=500

# ─── Ladder crawl ────────────────────────────────────────────────────────────
# Seconds between scheduled crawls; 0 means only on POST /v1/admin/ladder/crawl.
# LADDER_CRAWL_S=0
# CSV of RANKED_SOLO_5x5 and/or RANKED_FLEX_SR.
# LADDER_QUEUES=RANKED_SOLO_5x5
# CSV of platforms to crawl on LADDER_CRAWL_S; empty schedules none.
# LADDER_PLATFORMS=
# Lowest tier enumerated. MASTER is 3 requests per queue; IRON is the whole ladder.
# LADDER_TIER_FLOOR=MASTER
# Matches walked per discovered player; 0 discovers players without walking them.
# LADDER_BACKFILL_LIMIT=100
# Players a completed crawl's ranks:lookup looks up at most: archived players no
# ladder or earlier lookup placed, most games first; 0 turns it off.
# RANK_LOOKUP_LIMIT=50000
# Seconds a lookup keeps a player off the next list (7 days).
# RANK_LOOKUP_RECHECK_S=604800
# Days back a rank seen later places a player's unplaced (UNKNOWN) games in
# their tier; 0 leaves them unplaced.
# TIER_LATE_STAMP_DAYS=14

# ─── Facts and analytics ─────────────────────────────────────────────────────
# Matches re-extracted per facts:reextract batch.
# FACTS_REEXTRACT_BATCH=500
# Patches rebuilt per recompute; 0 rebuilds every archived patch.
# AGGREGATE_PATCH_LIMIT=4
# Seconds between unprompted recomputes; 0 disables (a finished crawl queues one anyway).
# AGGREGATE_INTERVAL_S=0

# ─── Static data ─────────────────────────────────────────────────────────────
# Unset: $DATA_DIR/ddragon.
# DDRAGON_DIR=
# DDRAGON_LOCALE=en_US

# ─── Security ────────────────────────────────────────────────────────────────
# CSV of IPs/CIDRs allowed to reach /v1/admin/*; empty allows any source (admin key still required).
# ADMIN_IP_ALLOWLIST=
# Take the client address from X-Forwarded-For. Only behind a reverse proxy that sets it:
# without one, any caller can forge the header and pass the allowlist.
# TRUST_PROXY=false
# Admin key to create on first run; unset means one is generated and printed once.
# BOOTSTRAP_ADMIN_KEY=
# Local testing only: skip consumer key checks. Refused when ENV is production.
# AUTH_DISABLED=false
# Testing only: send every Riot request, and the Data Dragon sync, to a mock
# (the acceptance suite's). Refused when ENV is production.
# RIOT_BASE_URL=
# DDRAGON_BASE_URL=

# ─── UIs ─────────────────────────────────────────────────────────────────────
# Browser client at /dev. Unset: on everywhere except production.
# DEV_UI=
# OpenAPI document and reference at /docs; on in production too.
# DOCS_UI=true
# Operational dashboard at /dashboard; the page is inert without an admin key.
# DASHBOARD_UI=true
