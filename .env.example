# ─── Riot ────────────────────────────────────────────────────────────────────
# The secret this whole project exists to protect. Dev keys expire every 24h.
RIOT_API_KEY=RGAPI-00000000-0000-0000-0000-000000000000
# Sent as User-Agent on every upstream call so Riot can identify you.
RIOT_USER_AGENT=riot-proxy/1.0 (+https://api.yourdomain.dev)

# ─── Service ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# ─── Backing services ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgres://proxy:proxy@localhost:5432/riotproxy

# ─── Behaviour ───────────────────────────────────────────────────────────────
DEFAULT_PLATFORM=euw1
# Optional CSV of TTL overrides in seconds, keyed by endpoint id (see src/riot/endpoints.ts)
# CACHE_TTL_OVERRIDES=league=120,spectator=20
NEG_TTL_SECONDS=30
NEG_TTL_ACCOUNT_SECONDS=300
SF_LOCK_MS=5000
CLIENT_WAIT_BUDGET_MS=2000
# Bulk work stops at this share of a bucket, keeping the rest for user-invoked
# requests. 0.80 reserves 20%.
BULK_USAGE_CEILING=0.80
STALE_WHILE_REVALIDATE=true
# Tick cadence of the `metrics` WebSocket topic, in seconds. Only spent while
# at least one socket is subscribed.
METRICS_INTERVAL_S=5

# ─── Worker cadence (seconds) ────────────────────────────────────────────────
TRACK_POLL_LIVE_S=60
TRACK_POLL_RANK_S=600
TRACK_POLL_MATCH_S=300
DDRAGON_SYNC_S=3600
ARCHIVE_TIMELINES=false
# Matches to walk back the first time a player is looked up. 10000 is match-v5's
# own ceiling, i.e. "their whole history"; 0 disables the behaviour.
LOOKUP_BACKFILL_LIMIT=10000
# How far back one match poll will page to find where it left off. Costs nothing
# in steady state; only spends after the ticks stopped. 0 = fixed window.
TRACK_CATCHUP_LIMIT=500

# ─── Static data ─────────────────────────────────────────────────────────────
DDRAGON_DIR=./data/ddragon
DDRAGON_LOCALE=en_US

# ─── Security ────────────────────────────────────────────────────────────────
# Comma-separated CIDR/IP allowlist for /v1/admin/*. Empty = allow any source IP
# (still requires an admin-scoped key).
ADMIN_IP_ALLOWLIST=127.0.0.1,::1
# Local testing only: skip consumer key checks entirely. Every request runs as a
# synthetic `dev-local` consumer with read+admin scope and no IP allowlist.
# The service refuses to boot with this set while NODE_ENV=production.
AUTH_DISABLED=false

# ─── Development tooling ─────────────────────────────────────────────────────
# Serve the browser client at /dev (public/dev-ui.html). Unset it follows
# NODE_ENV: on everywhere except production.
# DEV_UI=true

# Serve the OpenAPI document and the API reference at /docs. Unlike DEV_UI this
# defaults on in production: a published API's reference is part of its
# contract. Off removes /docs, /openapi.json and /openapi.yaml together.
# DOCS_UI=false

# Serve the operational dashboard at /dashboard. Like DOCS_UI this defaults on
# in production: the page is inert and everything behind it needs an admin key.
# DASHBOARD_UI=false

# Bootstrap admin key created on first migrate, printed once. Leave empty to skip.
BOOTSTRAP_ADMIN_KEY=
