# ─── Riot ────────────────────────────────────────────────────────────────────
# The secret this whole project exists to protect. Dev keys expire every 24h.
RIOT_API_KEY=RGAPI-00000000-0000-0000-0000-000000000000
# Sent as User-Agent on every upstream call so Riot can identify you.
RIOT_USER_AGENT=riot-proxy/1.0 (+https://api.yourdomain.dev)

# ─── Service ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# ─── Backing services ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgres://proxy:proxy@localhost:5432/riotproxy

# ─── Behaviour ───────────────────────────────────────────────────────────────
DEFAULT_PLATFORM=euw1
# Optional CSV of TTL overrides in seconds, keyed by endpoint id (see src/riot/endpoints.ts)
# CACHE_TTL_OVERRIDES=league=120,spectator=20
NEG_TTL_SECONDS=30
NEG_TTL_ACCOUNT_SECONDS=300
SF_LOCK_MS=5000
CLIENT_WAIT_BUDGET_MS=2000
BULK_USAGE_CEILING=0.75
STALE_WHILE_REVALIDATE=true

# ─── Worker cadence (seconds) ────────────────────────────────────────────────
TRACK_POLL_LIVE_S=60
TRACK_POLL_RANK_S=600
TRACK_POLL_MATCH_S=300
DDRAGON_SYNC_S=3600
ARCHIVE_TIMELINES=false

# ─── Static data ─────────────────────────────────────────────────────────────
DDRAGON_DIR=./data/ddragon
DDRAGON_LOCALE=en_US

# ─── Security ────────────────────────────────────────────────────────────────
# Comma-separated CIDR/IP allowlist for /v1/admin/*. Empty = allow any source IP
# (still requires an admin-scoped key).
ADMIN_IP_ALLOWLIST=127.0.0.1,::1
# Bootstrap admin key created on first migrate, printed once. Leave empty to skip.
BOOTSTRAP_ADMIN_KEY=
