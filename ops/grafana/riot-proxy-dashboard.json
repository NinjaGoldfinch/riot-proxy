{
  "title": "riot-proxy",
  "uid": "riot-proxy",
  "tags": ["riot-proxy"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "Cache hit ratio",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.7 },
              { "color": "green", "value": 0.85 }
            ]
          }
        }
      },
      "targets": [{ "expr": "proxy_cache_hit_ratio", "legendFormat": "hit ratio" }]
    },
    {
      "type": "stat",
      "title": "Accountable 429s (5m)",
      "description": "application/method 429s mean the limiter accounting is wrong (§9.4) — treat as a bug.",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(increase(proxy_rl_429_total{type=~\"application|method\"}[5m]))",
          "legendFormat": "accountable"
        }
      ]
    },
    {
      "type": "stat",
      "title": "WebSocket connections",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "sum(proxy_ws_connections)", "legendFormat": "sockets" }]
    },
    {
      "type": "stat",
      "title": "Upstream auth failures (15m)",
      "description": "Any 401/403 from Riot means the key is expired, revoked or blacklisted.",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(increase(proxy_upstream_requests_total{status=~\"401|403\"}[15m]))",
          "legendFormat": "auth failures"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Requests by cache state",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [
        {
          "expr": "sum by (cache) (rate(proxy_requests_total[5m]))",
          "legendFormat": "{{cache}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Requests by status",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "targets": [
        {
          "expr": "sum by (status) (rate(proxy_requests_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Upstream requests by method",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "targets": [
        {
          "expr": "sum by (method) (rate(proxy_upstream_requests_total[5m]))",
          "legendFormat": "{{method}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Upstream latency p50 / p95",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(proxy_upstream_latency_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(proxy_upstream_latency_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Rate limiter wait p95 by priority (§9.3)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, priority) (rate(proxy_rl_wait_seconds_bucket[5m])))",
          "legendFormat": "{{priority}} p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "429s by type",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 },
      "targets": [
        {
          "expr": "sum by (type) (rate(proxy_rl_429_total[5m]))",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Background jobs",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 29 },
      "targets": [
        {
          "expr": "sum by (job, status) (rate(proxy_jobs_total[5m]))",
          "legendFormat": "{{job}} {{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Matches archived",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 29 },
      "targets": [
        { "expr": "rate(proxy_archived_matches_total[5m])", "legendFormat": "archived/s" }
      ]
    }
  ]
}
